---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { PROFILE, CAREER, SKILLS } from "../../data/cv";
import galleries from "../../data/galleries.json";

const workShots = galleries.work as Record<string, string[]>;
const slugOf = (id: string) => id.replace(/^ko\//, "").replace(/\.md$/, "");
const all = (await getCollection("projects", (e) => e.id.startsWith("ko/"))).sort(
  (a, b) => a.data.order - b.data.order
);
const work = all.filter((e) => e.data.kind !== "side");

// 전면 케이스 5 (검증·운영 사례 우선) / 나머지는 Other Works 표
const MAIN = ["ground-control", "nova", "landbook-msa", "realty-data-pipeline", "zippit"];
const main = MAIN.map((s) => work.find((e) => slugOf(e.id) === s)).filter(Boolean) as typeof work;
const others = work.filter((e) => !MAIN.includes(slugOf(e.id))); // miriva·markwand·markbrief·garo·planreview

const AXIS: Record<string, string> = {
  agentops: "AI AGENT OPS", reliability: "DATA RELIABILITY", backend: "BACKEND · MSA",
  proptech: "PROPTECH", devtools: "DEV TOOLS",
};
// 케이스별 도식(제품 스크린샷 대신) + 핵심 증거 3개(사실 기반)
const FLOW: Record<string, any> = {
  "ground-control": { kind: "loop", nodes: ["주기 관찰", "원인 추론", "담당자에 조용히 DM", "피드백으로 학습"], cap: "신뢰도는 certain·likely·hypothesis 3단계 ‘언어’로 — 퍼센트 과신 제거" },
  "nova": { kind: "gate", nodes: ["AI 코드 생성", "적대적 게이트", "독립 평가자", "커밋"], gate: 1, cap: "생성과 검증 분리 — 같은 AI가 자기 코드를 승인하지 못한다" },
  "landbook-msa": { kind: "ba", before: ["단일 서비스", "한 곳 장애 → 전체 전파"], after: ["인증·결제·구독·필지 분리", "장애가 한 서비스에 격리"], cap: "무거운 작업은 Kafka로 떼어 격리 · 동기 호출은 Coroutine 비동기로" },
  "realty-data-pipeline": { kind: "gate", nodes: ["전국 원천", "staging 전구간 계산", "atomic swap", "운영 DB · 무중단"], gate: 2, cap: "‘workflow 성공 ≠ 데이터 성공’ — 안전 규칙을 문서가 아니라 훅으로 하드 블록" },
  "zippit": { kind: "flow", nodes: ["내 소득·현금", "DSR/LTV 규제 엔진", "전국 단지 매수 등급"], cap: "매물이 아니라 ‘내 통장’에서 출발 — 규제 로직은 순수 함수(테스트로 증명)" },
};
// 짧은 역할(플로우와 중복 제거) · INSIGHT 축약(증거 이미지 있는 페이지는 본문 가볍게)
const ROLE: Record<string, string> = {
  "ground-control": "관찰–추론–DM–피드백 루프를 단독 설계·구현",
  "nova": "생성–검증 게이트 방법론·플러그인 단독 설계·구현",
  "landbook-msa": "인증·결제·구독·필지 핵심 서비스 설계 (lead committer)",
  "realty-data-pipeline": "무중단 ETL 설계 + 안전 규칙 enforcement",
  "zippit": "기획·설계·구현 단독 주도 (거의 전량 커밋)",
};
const INSIGHT: Record<string, string> = {
  "ground-control": "자동화의 핵심은 탐지가 아니라, 사람이 믿고 행동할 수 있는 표현과 경로를 설계하는 일이었습니다.",
};
const PRINCIPLE: Record<string, string> = {
  "ground-control": "기본값은 공개 알림이 아니라 ‘조용한 확인’으로 설계",
  "nova": "품질은 더 똑똑한 모델이 아니라 ‘생성–검증 분리’ 구조로 설계",
  "landbook-msa": "MSA는 잘게 쪼개는 게 아니라 ‘장애·배포 경계’를 긋는 일",
  "realty-data-pipeline": "안전 규칙은 문서가 아니라 코드(훅)로 강제",
  "zippit": "정보 구조를 매물이 아니라 ‘사용자 재무’에서 출발하게 뒤집음",
};
const PROBLEM: Record<string, string> = {
  "ground-control": "모니터링 도구는 이상을 알려줬지만, 원인 지목·담당자 확인·재발 학습은 사람이 매번 수동으로 처리했습니다.",
};
const EVID: Record<string, string[]> = {
  "ground-control": ["퍼센트형 신뢰도 제거 — certain·likely·hypothesis로 제한", "공개채널 기본 발신 차단 — DM 우선 설계", "담당자 피드백 루프 내장 — 오탐 학습 가능"],
  "nova": ["생성과 검증을 구조로 분리 — 자기검토 차단", "맥락은 외부 임베딩 없이 텍스트로 — 이식성·투명성", "공개 OSS · Claude Code 플러그인"],
  "landbook-msa": ["장애·배포 경계를 긋는 MSA 설계", "무거운 작업은 Kafka로 격리", "lead committer · 합산 ~1,800 커밋"],
  "realty-data-pipeline": ["운영 DB를 덮어쓰지 않는 atomic swap", "안전 규칙을 문서 아닌 훅으로 강제", "‘성공 표시 ≠ 데이터 성공’ 전제"],
  "zippit": ["매물이 아니라 ‘내 통장’에서 출발", "규제 로직은 순수 함수 — 테스트로 증명", "전국 단지 등급화 실서비스 운영"],
};
// 케이스별 실제 화면 메타 — URL · 라벨 · 콜아웃 2개
const SHOT: Record<string, { url: string; label: string; pins: string[] }> = {
  "ground-control": { url: "gc.spacewalk.dev", label: "Ground Control 운영 대시보드", pins: ["실시간 관측 16/16", "신뢰도 3단계 언어 · 담당자 DM"] },
  "nova": { url: "github.com/jay-swk/nova", label: "Nova · 공개 OSS (Claude Code 플러그인)", pins: ["Generator–Evaluator 분리", "커밋 전 독립 평가자"] },
  "landbook-msa": { url: "landbook.net", label: "Landbook 서비스 화면", pins: ["인증·결제·구독·필지 분리", "장애 격리 · 독립 배포"] },
  "realty-data-pipeline": { url: "realty-pipeline · 내부", label: "Realty 파이프라인 모니터", pins: ["매월 무중단 갱신", "atomic swap"] },
  "zippit": { url: "zippit.im", label: "Zippit 서비스 화면", pins: ["내 통장 기준 매칭", "규제 로직 = 순수 함수"] },
};

const detailed = CAREER.filter((c: any) => c.featured);
const initial = PROFILE.name.charAt(0);
const pad = (n: number) => String(n).padStart(2, "0");
const TOTAL = 5 + main.length; // 표지·Why·Profile·케이스5·Other·Contact = 10
const SITE = "https://givepro91.github.io";
const GUIDE = "https://ax-field-guide.vercel.app";
---

<BaseLayout title="포트폴리오 (PDF)" description="장근식 — 문제·판단·증명의 포트폴리오">
  <div class="print-actions">
    <a href="/" class="pa-back">← Keunsik Works</a>
    <span class="pa-hint">⌘P → 레이아웃 "가로" · 배경 그래픽 ON</span>
    <button id="printBtn" class="pa-print">PDF로 저장 / 인쇄 ⌘P</button>
  </div>

  <div class="deck">
    <!-- ░ 01 COVER ░ -->
    <section class="slide cover">
      <div class="cover-top">
        <span class="brandmark">PORTFOLIO <b>2026</b></span>
        <span class="cover-axes">AI Agent Ops · Data Reliability · Backend · 0→1</span>
      </div>
      <div class="cover-mid">
        <p class="cover-eyebrow">AX = AI Transformation — AI 에이전트를 운영 시스템 안에 ‘안전하게’ 들이는 일</p>
        <h1>백엔드 10년을 기반으로,<br />AI 에이전트가 <span class="hl">안전하게 운영되는</span><br />제품 시스템을 설계·구현합니다.</h1>
        <p class="cover-name"><b>장근식</b> <span>Keun-sik Jang · AX Product · Engineering Lead</span></p>
      </div>
      <div class="cover-foot">
        <a class="cover-cta" href={SITE}>▶ givepro91.github.io<span>인터랙티브 결정 로그 10선 — 대표 포트폴리오</span></a>
        <span class="cover-contact">givepro91@gmail.com · 010-3175-9809</span>
      </div>
    </section>

    <!-- ░ 02 WHY ME (executive summary) ░ -->
    <section class="slide why">
      <div class="s-top"><span class="s-sec">WHY ME</span><span class="s-ctx">기능을 만든 사람이 아니라, 실패하지 않게 ‘구조’를 설계한 사람</span><span class="s-pg">02 / {TOTAL}</span></div>
      <div class="why-grid">
        <div class="why-card">
          <span class="why-n">01</span><h3>AI를 ‘실행’이 아니라 ‘통제’로</h3>
          <p>승인·취소·롤백·감사 로그(human-in-the-loop)로 에이전트가 어디서 멈추고 사람이 결정할지를 구조로 고정. 생성과 검증을 분리해 자기검토 편향을 제거.</p>
          <span class="why-ev">증거 — <b>Nova</b>(생성–검증 게이트, OSS) · <b>Ground Control</b>(자율 관제)</span>
        </div>
        <div class="why-card">
          <span class="why-n">02</span><h3>데이터·운영을 ‘침묵형 실패’에서 보호</h3>
          <p>‘workflow 성공 ≠ 데이터 성공’을 전제로 silent fail을 빌드·테스트 레벨에서 차단. 안전 규칙을 문서가 아니라 훅으로 강제.</p>
          <span class="why-ev">증거 — <b>Realty Pipeline</b>(무중단 ETL·운영 DB 다운 0) · 알림 수 분→수 초</span>
        </div>
        <div class="why-card">
          <span class="why-n">03</span><h3>0→1을 끝까지 운영까지</h3>
          <p>기획·설계·구현·배포를 단독 주도해 실서비스로 운영. 결정과 트레이드오프를 기록으로 남겨 팀이 재사용하는 플레이북으로.</p>
          <span class="why-ev">증거 — <b>Zippit</b>(실서비스) · <b>Landbook MSA</b>(lead committer · ~1,800 커밋)</span>
        </div>
      </div>
      <p class="why-foot">백엔드 10년을 <b>토대</b>로, 문제 정의 → 판단 → 운영 안전장치를 한 사이클로 만듭니다. &nbsp;상세 결정 로그 → <a href={SITE}>givepro91.github.io</a></p>
      <div class="s-foot"><span>장근식 · Portfolio 2026</span><a href={SITE}>givepro91.github.io</a></div>
    </section>

    <!-- ░ 03 PROFILE ░ -->
    <section class="slide">
      <div class="s-top"><span class="s-sec">PROFILE</span><span class="s-ctx">10년차 백엔드 → AX 리드 · PropTech × AI</span><span class="s-pg">03 / {TOTAL}</span></div>
      <div class="prof">
        <aside class="prof-card">
          <div class="avatar"><span>{initial}</span><img src={PROFILE.photo} alt="" onerror="this.remove()" /></div>
          <h2>{PROFILE.name}<small>{PROFILE.nameEn}</small></h2>
          <p class="prof-title">{PROFILE.title}<br />{PROFILE.domain}</p>
          <dl class="prof-contact">
            <div><dt>EMAIL</dt><dd><a href="mailto:givepro91@gmail.com">givepro91@gmail.com</a></dd></div>
            <div><dt>PHONE</dt><dd>010-3175-9809</dd></div>
            <div><dt>PORTFOLIO</dt><dd><a href={SITE}>givepro91.github.io</a></dd></div>
            <div><dt>AX NOTE</dt><dd><a href={GUIDE}>ax-field-guide.vercel.app</a></dd></div>
          </dl>
        </aside>
        <div class="prof-main">
          <div class="prof-sec">
            <h3 class="prof-h">CAREER</h3>
            {detailed.map((c: any) => (
              <div class="career">
                <div class="career-head"><b>{c.company}</b><span class="career-role">{c.role}</span><span class="career-per">{c.period}</span></div>
                {c.summary && <p class="career-sum">{c.summary}</p>}
              </div>
            ))}
            <p class="career-mini">2016–2020 · 피플리 이전 — 태전약품 · 앞선그룹 · 패스엔조이 · 청주교차로 등 커머스·플랫폼 백엔드/웹 개발</p>
          </div>
          <div class="prof-sec">
            <h3 class="prof-h">EXPERTISE — 영역별 대표 성과</h3>
            <div class="exp">
              <div class="exp-row"><span class="exp-k">AI Agent Ops</span><p><b>Nova·Ground Control</b> — 에이전트 통제·human-in-the-loop를 직접 설계·빌딩 (생성–검증 분리 게이트)</p></div>
              <div class="exp-row"><span class="exp-k">Data Reliability</span><p><b>Realty Pipeline</b> — 무중단 Blue-Green ETL로 운영 DB 다운 0 · silent fail 구조적 차단</p></div>
              <div class="exp-row"><span class="exp-k">Backend · MSA</span><p><b>Landbook</b> lead committer(~1,800 커밋) — 장애 격리 경계 설계 · 동기→비동기 전환</p></div>
              <div class="exp-row"><span class="exp-k">Stack</span><p>{SKILLS.find((g:any)=>g.group.includes("Backend"))?.items.slice(0,4).join(" · ")} · Kafka · Redis · AWS EKS · ArgoCD</p></div>
            </div>
          </div>
        </div>
      </div>
      <div class="s-foot"><span>장근식 · Portfolio 2026</span><a href={SITE}>givepro91.github.io</a></div>
    </section>

    <!-- ░ CASES 04–08 ░ -->
    {
      main.map((e, i) => {
        const d = e.data;
        const axis = AXIS[d.theme] ?? d.theme.toUpperCase();
        const fl = FLOW[slugOf(e.id)];
        const ev = EVID[slugOf(e.id)] ?? [];
        const shots = workShots[slugOf(e.id)] ?? [];
        const sh = SHOT[slugOf(e.id)];
        return (
          <section class="slide case">
            <div class="s-top"><span class="s-sec">WORK · CASE {pad(i + 1)}</span><span class="s-axis">{axis}</span><span class="s-pg">{pad(i + 4)} / {TOTAL}</span></div>
            <div class="case-grid">
              <div class="case-panel">
                <span class="case-no">CASE {pad(i + 1)}</span>
                <h2>{d.title.split(/\s*[—–]\s*/)[0]}</h2>
                <p class="case-what" set:html={d.positioning} />
                <div class="dgm-wrap">
                  {fl.kind === "ba" ? (
                    <div class="dgm-ba">
                      <div class="ba-row"><span class="ba-tag">BEFORE</span><div class="ba-nodes">{fl.before.map((n: string) => <span class="ba-node">{n}</span>)}</div></div>
                      <span class="ba-sep">▼</span>
                      <div class="ba-row after"><span class="ba-tag on">AFTER</span><div class="ba-nodes">{fl.after.map((n: string) => <span class="ba-node">{n}</span>)}</div></div>
                    </div>
                  ) : (
                    <div class="dgm">
                      {fl.nodes.map((n: string, idx: number) => (
                        <span class="dgm-step">{idx > 0 && <span class="dgm-arr">→</span>}<span class={`dgm-node${fl.gate === idx ? " gate" : ""}`}>{n}</span></span>
                      ))}
                      {fl.kind === "loop" && <span class="dgm-loop">↺ 반복</span>}
                    </div>
                  )}
                  <p class="dgm-cap">{fl.cap}</p>
                </div>
                <div class="evid"><span class="evid-h">핵심 증거</span>{ev.map((x) => <span class="evid-i">{x}</span>)}</div>
                {PRINCIPLE[slugOf(e.id)] && <p class="principle"><b>DESIGN PRINCIPLE</b> {PRINCIPLE[slugOf(e.id)]}</p>}
                <div class="case-side">
                  <div><span>역할</span>{ROLE[slugOf(e.id)] ?? d.role.replace(/<[^>]+>/g, "")}</div>
                  <div><span>TOOLS</span>{d.stack.join(" · ")}</div>
                </div>
              </div>
              <div class="case-detail">
                <div class="cd-blk"><h4>왜 · OVERVIEW</h4><p set:html={PROBLEM[slugOf(e.id)] ?? d.problem} /></div>
                <div class="cd-blk decide"><h4>판단 · KEY DECISION</h4><p set:html={d.decision} />
                  {d.decisionLog.slice(0, shots.length ? 0 : 2).length > 0 && <ul class="cd-log">{d.decisionLog.slice(0, shots.length ? 0 : 2).map((x: any) => <li><span set:html={x.why} />{x.tradeoff && <em set:html={x.tradeoff} />}</li>)}</ul>}
                </div>
                <div class="cd-blk impact"><h4>결과 · IMPACT</h4><p set:html={d.result} /></div>
                <div class="cd-blk insight"><h4>INSIGHT</h4><p set:html={INSIGHT[slugOf(e.id)] ?? d.learning} /></div>
                {shots.length > 0 && sh && (
                  <figure class="proof">
                    <figcaption>EVIDENCE · {sh.label} / 민감 정보 마스킹</figcaption>
                    <div class="proof-win">
                      <span class="proof-bar"><i /><i /><i /><span class="proof-url">{sh.url}</span></span>
                      <img src={shots[0]} alt={`${d.title} 실제 화면`} />
                      <span class="proof-pins">{sh.pins.map((p) => <span>● {p}</span>)}</span>
                    </div>
                  </figure>
                )}
              </div>
            </div>
            <div class="s-foot"><span>장근식 · {axis}</span><a href={d.visibility === "public" && d.link ? d.link : SITE}>{d.visibility === "public" && d.link ? d.link.replace(/^https?:\/\//, "") : "givepro91.github.io"}</a></div>
          </section>
        );
      })
    }

    <!-- ░ 09 OTHER WORKS / PROOF TABLE ░ -->
    <section class="slide">
      <div class="s-top"><span class="s-sec">OTHER WORKS</span><span class="s-ctx">부록 — 진행 단계·기여 사례</span><span class="s-pg">09 / {TOTAL}</span></div>
      <h2 class="ow-h">그 외 작업 — Proof Table</h2>
      <table class="ow-tbl">
        <thead><tr><th>프로젝트</th><th>한 줄</th><th>역할 · 규모</th><th>핵심</th></tr></thead>
        <tbody>
          {others.map((e) => {
            const d = e.data;
            const disc = slugOf(e.id) === "miriva";
            return (
              <tr>
                <td class="ow-name">{d.title.split(/\s*[—–]\s*/)[0]}{disc && <span class="ow-tag">DISCOVERY</span>}</td>
                <td class="ow-pos" set:html={d.positioning} />
                <td class="ow-role">{d.metrics ?? d.period}</td>
                <td class="ow-key">{d.theme === "proptech" ? "PropTech 도메인" : AXIS[d.theme] ?? d.theme}{disc ? " · 가설 검증(confidence 55%·conditional-go)" : ""}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="ow-note"><b>MIRIVA</b>는 운영 SaaS의 <b>product discovery / validation</b> 사례입니다 — 기능보다 먼저 ‘이 가설이 틀렸는지’를 적대적 PRD로 검증한 단계.</p>
