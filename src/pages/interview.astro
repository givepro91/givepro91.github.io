---
// 비공개 면접 준비 페이지.
// 내용은 빌드 전에 이미 암호화돼 있고(scripts/seal-interview.mjs), 이 페이지는
// 암호문을 그대로 실어 나른다. 복호화는 비밀번호를 아는 사람의 브라우저에서만 일어난다.
//
// BaseLayout 을 쓰지 않는다 — GA 추적·OG 카드·사이트맵이 함께 딸려오기 때문이다.
// 대신 전역 CSS 와 폰트는 BaseLayout 과 동일하게 불러와 사이트 디자인 시스템을 그대로 쓴다.
import "../styles/global.css";
import sealed from "../data/interview.sealed.json";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>비공개</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>

  <body>
    <script type="application/json" id="sealed" set:html={JSON.stringify(sealed)} />

    <main class="iv">
      <section id="lock" class="iv-lock">
        <div class="iv-lock-card card">
          <span class="sec-label">private</span>
          <h1 class="iv-lock-title">면접 준비 노트</h1>
          <p class="iv-lock-sub">내용이 암호화되어 있습니다. 비밀번호를 입력하면 이 브라우저에서 열립니다.</p>
          <form id="lock-form" class="iv-lock-form">
            <input
              id="pw"
              type="password"
              placeholder="비밀번호"
              autocomplete="current-password"
              autofocus
            />
            <button id="unlock" type="submit" class="iv-btn iv-btn-primary">열기</button>
          </form>
          <p id="msg" class="iv-msg" role="status"></p>
        </div>
      </section>

      <section id="doc" hidden>
        <header class="iv-head">
          <div class="iv-head-inner">
            <nav id="tabs" class="iv-tabs" aria-label="섹션"></nav>
            <div class="iv-tools">
              <input id="q" type="search" placeholder="질문·답변·태그 검색" />
              <button id="expand" type="button" class="iv-btn">모두 펼치기</button>
              <button id="relock" type="button" class="iv-btn">잠그기</button>
            </div>
          </div>
        </header>

        <div id="list" class="iv-list"></div>
        <p id="empty" class="iv-empty" hidden>검색 결과가 없습니다.</p>
      </section>
    </main>

    <script>
      const box = JSON.parse(document.getElementById("sealed").textContent);
      const $ = (id) => document.getElementById(id);
      const STORE_KEY = "iv-pw";

      let content = null;
      let active = 0;
      let allOpen = false;

      const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

      async function decrypt(password) {
        const material = await crypto.subtle.importKey(
          "raw",
          new TextEncoder().encode(password),
          "PBKDF2",
          false,
          ["deriveKey"],
        );
        const aesKey = await crypto.subtle.deriveKey(
          {
            name: "PBKDF2",
            salt: b64(box.kdf.salt),
            iterations: box.kdf.iter,
            hash: box.kdf.hash,
          },
          material,
          { name: "AES-GCM", length: 256 },
          false,
          ["decrypt"],
        );
        const plain = await crypto.subtle.decrypt(
          { name: "AES-GCM", iv: b64(box.iv) },
          aesKey,
          b64(box.ct),
        );
        return JSON.parse(new TextDecoder().decode(plain));
      }

      function renderTabs() {
        $("tabs").replaceChildren();
        content.sections.forEach((section, i) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = i === active ? "iv-tab on" : "iv-tab";
          btn.setAttribute("aria-pressed", String(i === active));

          const label = document.createElement("span");
          label.textContent = section.title;
          const count = document.createElement("span");
          count.className = "iv-tab-n mono";
          count.textContent = section.items.length;

          btn.append(label, count);
          btn.addEventListener("click", () => {
            active = i;
            renderTabs();
            renderList();
          });
          $("tabs").append(btn);
        });
      }

      function renderList() {
        const term = $("q").value.trim().toLowerCase();
        const items = content.sections[active].items.filter(
          (it) =>
            !term ||
            it.q.toLowerCase().includes(term) ||
            it.a.toLowerCase().includes(term) ||
            it.tags.some((t) => t.toLowerCase().includes(term)),
        );

        $("list").replaceChildren();
        items.forEach((it, i) => {
          const details = document.createElement("details");
          details.className = "iv-item card";
          details.open = allOpen || Boolean(term);

          const summary = document.createElement("summary");
          summary.className = "iv-q";

          const num = document.createElement("span");
          num.className = "iv-n mono";
          num.textContent = String(i + 1).padStart(2, "0");
          const text = document.createElement("span");
          text.textContent = it.q;
          summary.append(num, text);

          const body = document.createElement("div");
          body.className = "iv-a";
          // 본인이 작성해 본인 비밀번호로 봉인한 내용만 들어온다 — 신뢰 경계 안이다.
          body.innerHTML = it.a;

          if (it.tags.length) {
            const tags = document.createElement("div");
            tags.className = "chips iv-tags";
            for (const t of it.tags) {
              const chip = document.createElement("span");
              chip.className = "chip";
              chip.textContent = t;
              tags.append(chip);
            }
            body.append(tags);
          }

          details.append(summary, body);
          $("list").append(details);
        });
        $("empty").hidden = items.length > 0;
      }

      async function attempt(password, fromStorage) {
        $("unlock").disabled = true;
        $("msg").textContent = "여는 중…";
        $("msg").classList.remove("err");
        try {
          content = await decrypt(password);
          sessionStorage.setItem(STORE_KEY, password);
          $("msg").textContent = "";
          $("lock").hidden = true;
          $("doc").hidden = false;
          renderTabs();
          renderList();
        } catch {
          sessionStorage.removeItem(STORE_KEY);
          $("msg").textContent = fromStorage ? "" : "비밀번호가 틀렸습니다.";
          $("msg").classList.toggle("err", !fromStorage);
          $("pw").value = "";
          $("pw").focus();
        } finally {
          $("unlock").disabled = false;
        }
      }

      if (!window.crypto?.subtle) {
        $("msg").textContent = "이 브라우저에서는 열 수 없습니다. 최신 브라우저에서 https 로 접속하세요.";
        $("msg").classList.add("err");
      } else {
        $("lock-form").addEventListener("submit", (e) => {
          e.preventDefault();
          attempt($("pw").value, false);
        });
        $("q").addEventListener("input", renderList);
        $("expand").addEventListener("click", () => {
          allOpen = !allOpen;
          $("expand").textContent = allOpen ? "모두 접기" : "모두 펼치기";
          renderList();
        });
        $("relock").addEventListener("click", () => {
          sessionStorage.removeItem(STORE_KEY);
          location.reload();
        });

        const saved = sessionStorage.getItem(STORE_KEY);
        if (saved) attempt(saved, true);
      }
    </script>

    <!-- is:global 이어야 한다 — 문항·탭은 복호화 후 JS 로 만들어지는데,
         Astro 의 scoped 스타일은 템플릿에 있는 요소에만 속성을 붙이므로
         동적 생성 요소에는 규칙이 하나도 적용되지 않는다. -->
    <style is:global>
      /* 전역 리셋이 * { margin: 0 } 이라, 이 페이지의 본문 리듬은 여기서 직접 세운다. */
      .iv {
        max-width: 820px;
        margin: 0 auto;
        padding: 0 24px 96px;
      }

      /* hidden 속성은 UA 스타일의 display:none 으로 동작한다.
         아래에서 display 를 지정하는 요소들이 그걸 덮어버리므로 명시적으로 되살린다. */
      [hidden] { display: none !important; }

      /* ---------- 잠금 화면 ---------- */
      .iv-lock {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100dvh;
      }
      .iv-lock-card {
        width: 100%;
        max-width: 420px;
        padding: 32px 30px 28px;
      }
      .iv-lock-title {
        font-size: 21px;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 10px 0 6px;
      }
      .iv-lock-sub {
        font-size: 13.5px;
        line-height: 1.6;
        color: var(--ink-mute);
      }
      .iv-lock-form {
        display: flex;
        gap: 8px;
        margin-top: 22px;
      }
      .iv-lock-form input {
        flex: 1;
        min-width: 0;
      }
      .iv-msg {
        margin-top: 12px;
        min-height: 20px;
        font-size: 13px;
        color: var(--ink-mute);
      }
      .iv-msg.err {
        color: var(--warn);
        font-weight: 500;
      }

      /* ---------- 공통 폼 ---------- */
      .iv input {
        font-family: var(--sans);
        font-size: 14.5px;
        color: var(--ink);
        background: var(--card);
        border: 1px solid var(--line-2);
        border-radius: var(--r-sm);
        padding: 10px 13px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .iv input::placeholder { color: var(--ink-mute); }
      .iv input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-weak);
      }
      .iv-btn {
        font-family: var(--sans);
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink-sub);
        background: var(--card);
        border: 1px solid var(--line-2);
        border-radius: var(--r-sm);
        padding: 10px 14px;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }
      .iv-btn:hover { background: var(--surface); color: var(--ink); }
      .iv-btn-primary {
        color: #fff;
        background: var(--accent);
        border-color: var(--accent);
      }
      .iv-btn-primary:hover { background: var(--accent-ink); color: #fff; }
      .iv-btn-primary:disabled { opacity: 0.6; cursor: default; }

      /* ---------- 헤더 ---------- */
      .iv-head {
        position: sticky;
        top: 0;
        z-index: 5;
        margin: 0 -24px;
        padding: 18px 24px 14px;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .iv-head-inner { max-width: 820px; margin: 0 auto; }
      .iv-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
      .iv-tab {
        display: inline-flex;
        align-items: baseline;
        gap: 7px;
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-sub);
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--r-chip);
        padding: 7px 15px;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }
      .iv-tab:hover { border-color: var(--line-2); }
      .iv-tab.on {
        color: var(--accent-ink);
        background: var(--accent-weak);
        border-color: var(--accent-border);
      }
      .iv-tab-n { font-size: 11.5px; font-weight: 500; opacity: 0.75; }
      .iv-tools { display: flex; gap: 8px; margin-top: 12px; }
      .iv-tools input { flex: 1; min-width: 0; }

      /* ---------- 문항 목록 ---------- */
      .iv-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 22px;
      }
      .iv-item {
        padding: 0 24px;
        transition: box-shadow 0.15s ease, border-color 0.15s ease;
      }
      .iv-item[open] { box-shadow: var(--sh-hover); }
      .iv-q {
        display: flex;
        gap: 12px;
        align-items: baseline;
        padding: 18px 0;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.6;
        letter-spacing: -0.015em;
        color: var(--ink);
        cursor: pointer;
        list-style: none;
      }
      /* summary 를 flex 로 쓰면 list-style:none 만으로는 기본 삼각형이 안 사라진다. */
      .iv-q::-webkit-details-marker { display: none; }
      .iv-q::marker { content: ""; }
      .iv-q:hover { color: var(--accent-ink); }
      .iv-q::after {
        content: "";
        flex: none;
        margin-left: auto;
        align-self: center;
        width: 7px;
        height: 7px;
        border-right: 1.5px solid var(--ink-mute);
        border-bottom: 1.5px solid var(--ink-mute);
        transform: rotate(45deg) translate(-2px, -2px);
        transition: transform 0.18s ease, border-color 0.18s ease;
      }
      .iv-item[open] .iv-q::after {
        transform: rotate(225deg) translate(-2px, -2px);
        border-color: var(--accent);
      }
      .iv-n {
        flex: none;
        font-size: 11.5px;
        font-weight: 500;
        color: var(--ink-mute);
        transform: translateY(-1px);
      }
      .iv-item[open] .iv-n { color: var(--accent); }

      /* ---------- 답변 본문 ---------- */
      .iv-a {
        padding: 4px 0 24px 30px;
        border-top: 1px solid var(--line);
        margin-top: -1px;
        padding-top: 20px;
      }
      .iv-a p {
        font-size: 15.5px;
        line-height: 1.85;
        color: var(--ink);
      }
      .iv-a p + p { margin-top: 15px; }
      .iv-a h4 {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 24px 0 10px;
      }
      .iv-a ul {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .iv-a li {
        position: relative;
        padding-left: 16px;
        font-size: 14.5px;
        line-height: 1.8;
        color: var(--ink-sub);
      }
      .iv-a li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.75em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--line-2);
      }
      .iv-a blockquote {
        margin: 16px 0;
        padding: 14px 18px;
        font-size: 14.5px;
        line-height: 1.8;
        color: var(--ink-sub);
        background: var(--accent-weak);
        border-left: 3px solid var(--accent-border);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
      }
      .iv-a blockquote p + p { margin-top: 10px; }
      .iv-a code {
        font-family: var(--mono);
        font-size: 0.88em;
        color: var(--accent-ink);
        background: var(--accent-weak);
        padding: 2px 5px;
        border-radius: 5px;
      }
      .iv-a strong { font-weight: 700; }
      .iv-tags { margin-top: 22px; }

      .iv-empty {
        margin-top: 40px;
        text-align: center;
        font-size: 14px;
        color: var(--ink-mute);
      }

      @media (max-width: 640px) {
        .iv { padding: 0 16px 72px; }
        .iv-head { margin: 0 -16px; padding: 14px 16px 12px; }
        .iv-item { padding: 0 18px; }
        .iv-a { padding-left: 0; }
        .iv-tools { flex-wrap: wrap; }
        .iv-tools input { flex-basis: 100%; }
      }

      @media print {
        .iv-head { display: none; }
        .iv-item { break-inside: avoid; box-shadow: none; }
      }
    </style>
  </body>
</html>
