---
import BaseLayout from "../layouts/BaseLayout.astro";

// 시장이 2026년 'table stakes'로 올린 테마 (출처 기반 — AX Field Guide에 근거 정리)
const marketThemes = [
  "AgentOps",
  "eval · LLMOps",
  "Retrieval 깊이 (agentic · GraphRAG)",
  "Human-in-the-loop",
  "Context Engineering",
  "AI 거버넌스",
  "AI 코딩 에이전트 실무",
];

// 시장 키워드 → 이미 직접 빌딩한 증거(Work 결정 로그로 링크)
const stand = [
  {
    market: "AgentOps · 생성–검증 분리",
    evidence: "AI가 생성한 코드를 독립 평가자가 커밋 전 적대적으로 검증하는 품질 게이트",
    name: "Nova",
    slug: "nova",
  },
  {
    market: "Human-in-the-loop 운영 통제",
    evidence: "원인을 추론해 담당자에게 조용히 묻고 피드백으로 학습하는 자율 인프라 관제",
    name: "Ground Control",
    slug: "ground-control",
  },
  {
    market: "데이터 신뢰성 · 상태 ≠ 결과",
    evidence: "‘workflow 성공’이 곧 데이터 성공이 아님을 구조로 막은 무중단 Blue-Green ETL",
    name: "Realty Data Pipeline",
    slug: "realty-data-pipeline",
  },
  {
    market: "측정 기반 · 적대적 검증",
    evidence: "기능보다 먼저 ‘이 가설이 틀렸는지’ 검증하는 적대적 PRD 게이트로 시작한 운영 관제",
    name: "MIRIVA",
    slug: "miriva",
  },
];

// 지금 깊게 파는 중 — '못하는 것'이 아니라 '의도적으로 파고드는 다음 깊이'
const deep = [
  {
    when: "Retrieval 깊이",
    what: "검색이 2026의 진짜 병목입니다. hybrid search · reranking · query routing · <b>agentic/GraphRAG</b>를 PropTech 도메인(계약·도면·매물 데이터)에 맞춰 검색 품질을 정량적으로 끌어올리는 중.",
  },
  {
    when: "Eval 정량화",
    what: "이미 만든 생성–검증 게이트를 <b>Langfuse trace + LLM-as-judge</b>로 표준화. offline eval set과 production trace에 task success · latency · cost-per-task 3지표를 명문화하는 작업.",
  },
  {
    when: "AI 거버넌스",
    what: "<b>OWASP LLM/Agentic Top 10 · NIST AI RMF · EU AI Act</b>(2026.8 고위험 의무 발효)를 문서가 아니라 <b>조직 정책·위협 모델</b>로 옮기는 중 — 리드는 가드레일을 정책으로 소유해야 하니까.",
  },
];

// 다음 분기 로드맵 — 강한 영역은 재라벨링, 새 학습은 갭에 집중
const roadmap = [
  {
    when: "0–3개월",
    title: "강점을 시장 언어로 + eval 정량화",
    why: "가장 빠른 ROI는 새 학습이 아니라, 이미 앞서 있는 자산을 시장 어휘(eval-driven · context engineering)로 재라벨링·증명하는 일.",
    what: "품질 게이트를 Langfuse + LLM-judge eval 파이프라인으로 계측 · 에이전트 자산을 LangGraph 어휘(checkpoint·HITL·routing)로 매핑.",
    proof: "계측된 eval 케이스 + 회사/외부 블로그 글 1편",
  },
  {
    when: "3–6개월",
    title: "Retrieval 깊이 + 거버넌스",
    why: "retrieval이 2026 병목이고, 리드는 거버넌스를 조직 정책으로 소유해야 한다.",
    what: "도메인 RAG에 reranker·query router·agentic/GraphRAG 적용 · OWASP/NIST/EU AI Act를 위협 모델·정책으로 내재화.",
    proof: "검색 품질 지표가 붙은 도메인 RAG 리포트 + AI 거버넌스 문서 1건",
  },
  {
    when: "6–12개월",
    title: "비즈니스 가치 번역 + 공개 증명",
    why: "기술 갭이 닫히면 남는 차별점은 ‘문제 → ROI → 워크플로 재설계’와 교차기능 리딩 — AX 리드의 정체성 그 자체.",
    what: "적대적 PRD를 ‘가치 가설 + 성공지표’로 확장 · eval 프레임/agent-ops 패턴을 오픈소스로 공개 · 외부 발표.",
    proof: "전후 비즈니스 지표가 붙은 AX 케이스 + OSS 릴리스 + 발표",
  },
];
---

<BaseLayout
  title="Roadmap — 학습과 다음 수"
  description="장근식(@givepro91)의 AX 학습·연구 로드맵 — 시장 좌표, 현재 위치, 다음 분기에 깊게 파는 것."
>
  <section class="rm">
    <div class="wrap" style="max-width:900px">
      <!-- HERO -->
      <div class="rm-hero reveal">
        <p class="rm-kicker">log.roadmap — 학습과 다음 분기 · 갱신 2026.06</p>
        <h1 class="rm-title">시장을 읽고, 내 좌표를 찍고, 다음을 판다</h1>
        <p class="rm-lead">
          AX 시장이 어디로 움직이는지 추적하고, 내가 지금 <b>어디에 서 있는지</b>, 다음 분기에
          <b>무엇을 깊게 파는지</b>를 공개합니다. 완성된 결론이 아니라 진행 중인 좌표입니다 —
          <span class="rm-mut">새로운 기술을 빠르게 익혀 직접 써보는 것 자체가 AX의 일이라 믿기 때문에.</span>
        </p>
        <div class="rm-hero-links">
          <a class="pill primary" href="https://ax-field-guide.vercel.app" target="_blank" rel="noopener">AX Field Guide — 시장·기법 근거 ↗</a>
          <a class="pill" href="/cv/">이력서 CV →</a>
          <a class="pill" href="/#work">결정 로그 Work →</a>
        </div>
      </div>

      <!-- 시장 좌표 -->
      <section class="rm-sec reveal">
        <div class="sec-head"><span class="sec-label">01</span><span class="sec-title">시장 좌표 — 어디로 가고 있나</span></div>
        <p class="sec-note">
          2026년 한국 AX 채용은 ‘AI를 이해하고 <b>직접 빌딩</b>하며 현업↔기술을 통역해 0→1을 운영까지 끌고 가는 경계인’으로 수렴 중.
          키워드는 LLMOps → <b>AgentOps</b>, RAG → <b>retrieval 깊이</b>, <b>eval/ROI</b>, human-in-the-loop, 거버넌스로 이동했습니다.
        </p>
        <div class="chips">{marketThemes.map((t, i) => <span class={`chip ${i === 0 ? "blue" : ""}`}>{t}</span>)}</div>
      </section>

      <!-- 내 현재 좌표 -->
      <section class="rm-sec reveal">
        <div class="sec-head"><span class="sec-label">02</span><span class="sec-title">내 현재 좌표 — 이미 빌딩해 둔 것</span></div>
        <p class="sec-note">시장이 막 ‘table stakes’로 올린 영역에, 이미 직접 만든 제품이 있습니다. 키워드가 아니라 결정 로그로 증명합니다.</p>
        <div class="stand-list">
          {stand.map((s) => (
            <a class="stand-row" href={`/work/${s.slug}/`}>
              <span class="stand-market">{s.market}</span>
              <span class="stand-ev">{s.evidence}</span>
              <span class="stand-name">{s.name} <span class="stand-arr">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <!-- 지금 깊게 파는 중 -->
      <section class="rm-sec reveal">
        <div class="sec-head"><span class="sec-label">03</span><span class="sec-title">지금 깊게 파는 중</span></div>
        <p class="sec-note">강점 옆의 ‘다음 깊이’. 의도적으로 시간을 쓰고 있는 곳입니다.</p>
        <div class="now-grid rm-deep">
          {deep.map((d) => (
            <div class="now-card">
              <span class="now-when">{d.when}</span>
              <p set:html={d.what} />
            </div>
          ))}
        </div>
      </section>

      <!-- 다음 분기 로드맵 -->
      <section class="rm-sec reveal">
        <div class="sec-head"><span class="sec-label">04</span><span class="sec-title">다음 분기 로드맵</span></div>
        <p class="sec-note">이미 강한 영역(agent ops · HITL · 데이터 신뢰성)은 재라벨링하고, 새 학습은 갭(retrieval · eval 규율 · 거버넌스 · 비즈니스 번역)에 집중합니다.</p>
        <div class="rm-timeline">
          {roadmap.map((p) => (
            <div class="rm-phase">
              <div class="rm-phase-when">{p.when}</div>
              <div class="rm-phase-body">
                <h3 class="rm-phase-title">{p.title}</h3>
                <p class="rm-phase-line"><span class="rm-lbl">왜</span>{p.why}</p>
                <p class="rm-phase-line"><span class="rm-lbl">무엇</span>{p.what}</p>
                <p class="rm-phase-line"><span class="rm-lbl proof">증명</span>{p.proof}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="rm-foot reveal">
        <a class="pill primary" href="https://ax-field-guide.vercel.app" target="_blank" rel="noopener">AX Field Guide ↗</a>
        <a class="pill" href="/cv/">이력서 CV</a>
        <a class="pill" href="/">← Keunsik Works</a>
      </div>
    </div>
  </section>

  <style>
    .rm { padding: 40px 0 72px; }
    .rm-hero { padding-bottom: 30px; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
    .rm-kicker { font-family: var(--mono); font-size: 12px; color: var(--accent); letter-spacing: 0.04em; margin-bottom: 14px; }
    .rm-title { font-size: clamp(26px, 4vw, 36px); font-weight: 800; letter-spacing: -0.03em; color: var(--ink); line-height: 1.18; }
    .rm-lead { margin-top: 16px; font-size: 16px; line-height: 1.74; color: var(--ink-sub); max-width: 64ch; }
    .rm-lead b { color: var(--ink); font-weight: 600; }
    .rm-mut { color: var(--ink-mute); }
    .rm-hero-links { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 20px; }

    .rm-sec { padding: 30px 0 6px; border-top: 1px solid var(--line); margin-top: 26px; }
    .rm-sec:first-of-type { border-top: none; margin-top: 0; }
    .rm-sec .sec-head { margin-bottom: 8px; }
    .rm-sec .sec-label { color: var(--accent); }

    /* 02 — 시장 키워드 → 내 증거 */
    .stand-list { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
    .stand-row {
      display: grid; grid-template-columns: 200px 1fr auto; gap: 16px; align-items: center;
      padding: 15px 18px; background: var(--card); border: 1px solid var(--line);
      border-radius: var(--r); box-shadow: var(--sh); transition: transform .12s ease, border-color .12s ease;
    }
    .stand-row:hover { transform: translateY(-2px); border-color: var(--accent-border); }
    .stand-market { font-family: var(--mono); font-size: 12.5px; font-weight: 600; color: var(--accent-ink); }
    .stand-ev { font-size: 14px; color: var(--ink-sub); line-height: 1.55; }
    .stand-name { font-weight: 700; color: var(--ink); white-space: nowrap; }
    .stand-arr { color: var(--accent); }
    @media (max-width: 720px) {
      .stand-row { grid-template-columns: 1fr; gap: 6px; }
      .stand-name { white-space: normal; }
    }

    /* 03 — 깊게 파는 중 (now-card 재사용, 3열) */
    .rm-deep { grid-template-columns: 1fr 1fr 1fr; }
    @media (max-width: 860px) { .rm-deep { grid-template-columns: 1fr; } }

    /* 04 — 타임라인 */
    .rm-timeline { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
    .rm-phase {
      display: grid; grid-template-columns: 116px 1fr; gap: 18px;
      padding: 18px 20px; background: var(--card); border: 1px solid var(--line);
      border-left: 3px solid var(--accent); border-radius: var(--r); box-shadow: var(--sh);
    }
    .rm-phase-when { font-family: var(--mono); font-size: 13px; font-weight: 600; color: var(--accent-ink); padding-top: 2px; }
    .rm-phase-title { font-size: 16.5px; font-weight: 700; color: var(--ink); margin-bottom: 10px; letter-spacing: -0.01em; }
    .rm-phase-line { font-size: 14px; color: var(--ink-sub); line-height: 1.6; margin-top: 7px; display: flex; gap: 10px; }
    .rm-lbl { flex: none; width: 34px; font-family: var(--mono); font-size: 10.5px; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.03em; padding-top: 3px; }
    .rm-lbl.proof { color: var(--ok); }
    @media (max-width: 720px) {
      .rm-phase { grid-template-columns: 1fr; gap: 10px; }
      .rm-phase-when { padding-top: 0; }
    }

    .rm-foot { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--line); }
  </style>
</BaseLayout>
