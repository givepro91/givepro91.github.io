---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE, CHANNELS, FEATURED_WRITING, THEMES } from "../config";
import { PROFILE } from "../data/cv";
import { LAB } from "../data/lab";

const all = (await getCollection("projects", (e) => e.id.startsWith("ko/"))).sort(
  (a, b) => a.data.order - b.data.order
);
const work = all.filter((e) => e.data.kind !== "side");
const side = all.filter((e) => e.data.kind === "side");

const lab = [...LAB].sort((a, b) => a.order - b.order);

// lab status → 한글 라벨 + 색상 클래스
const LAB_STATUS: Record<string, { label: string; cls: string }> = {
  active: { label: "진행중", cls: "run" },
  prototype: { label: "프로토타입", cls: "tool" },
  experiment: { label: "실험", cls: "exp" },
  paused: { label: "중단", cls: "pause" },
  side: { label: "사이드", cls: "pause" },
};

const now = [
  {
    when: "2026.Q3",
    what: "<b>전환과 폐기를 끝내는 실행 게이트</b> — 라이브 재검증, 잔여 의존성 확인, 인계 문서를 다음 사람이 근거를 따라 판단할 수 있는 흐름으로 묶고 있습니다.",
  },
  {
    when: "진행중",
    what: "<b>데이터·상태의 신뢰 경계</b> — \"workflow 성공 ≠ 데이터 성공\"을 빌드·테스트 레벨에서 강제하는 방법을 정리하고 있습니다.",
  },
];

const photo = PROFILE.photo;
const initial = SITE.name.charAt(0);

// hero 빠른 링크 (CHANNELS에서 큐레이션 — 라벨 충돌 방지)
const byLabel = (m: string) => CHANNELS.find((c) => c.label.includes(m))?.href ?? "#";
const heroLinks = [
  { label: "GitHub @givepro91", href: byLabel("givepro91") },
  { label: "LinkedIn", href: byLabel("LinkedIn") },
  { label: "Brunch", href: byLabel("Brunch") },
];
---

<BaseLayout>
  <!-- SIDE TOC (scroll-spy) -->
  <aside class="toc" aria-label="목차">
    <a href="#now" data-spy="now"><span class="bar"></span>Now</a>
    <div class="toc-group">
      <a href="#work" data-spy="work"><span class="bar"></span>Work</a>
      <div class="toc-sub">
        {
          work.map((entry) => {
            const s = entry.id.replace(/^ko\//, "");
            let short = entry.data.title.split(/\s*[—–]\s*/)[0].trim();
            if (short.length > 13) {
              const cut = short.slice(0, 13);
              const sp = cut.lastIndexOf(" ");
              short = (sp > 6 ? cut.slice(0, sp) : cut).trim() + "…";
            }
            return <a href={`#w-${s}`} data-spy-sub={`w-${s}`} title={entry.data.title}>{short}</a>;
          })
        }
      </div>
    </div>
    {side.length > 0 && <a href="#side" data-spy="side"><span class="bar" />Side</a>}
    <a href="#lab" data-spy="lab"><span class="bar"></span>Lab</a>
    <a href="#about" data-spy="about"><span class="bar"></span>About</a>
  </aside>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <!-- profile card -->
      <div class="card profile reveal">
        <div class="profile-top">
          <div class="avatar">
            <span class="avatar-fallback">{initial}</span>
            {photo && (
              <img src={photo} alt={`${SITE.name} 프로필 사진`} loading="eager" onerror="this.remove()" />
            )}
          </div>
          <div>
            <div class="p-name-row">
              <span class="p-name">{SITE.name}</span>
              <span class="p-name-en">{SITE.nameEn}</span>
            </div>
            <div class="p-title">{SITE.title}</div>
            <div class="p-subtitle">{SITE.subtitle}</div>
            <span class="p-status"><span class="live"></span>스페이스워크 재직 중 · 10년차</span>
          </div>
        </div>
        <p class="p-tagline">
          AI를 붙이는 개발자가 아니라, <b>조직 전체가 AI와 안전하게 일하는 운영 구조</b>를 설계하는
          사람입니다.
        </p>
        <p class="p-sub">무엇을 만들었나보다, 왜 그렇게 판단했나를 기록합니다.</p>
        <div class="p-actions">
          <a class="pill primary" href="/cv/">이력서 CV 보기 →</a>
          {heroLinks.map((l) => (
            <a class="pill" href={l.href} target="_blank" rel="noopener">{l.label}</a>
          ))}
        </div>
      </div>

      <!-- infobox (wiki) -->
      <aside class="card infobox reveal">
        <div class="infobox-h"><span>Profile</span><span>갱신 2026.07</span></div>
        <dl>
          <dt>경력</dt>
          <dd><b>10년차</b> · 백엔드·제품 → AX 리드</dd>
          <dt>현재</dt>
          <dd>스페이스워크 (주) 재직 중</dd>
          <dt>도메인</dt>
          <dd>PropTech × AI</dd>
          <dt>위치</dt>
          <dd>{PROFILE.location}</dd>
          <dt>핸들</dt>
          <dd><b>@givepro91</b></dd>
        </dl>
        <div class="ib-themes">
          <div class="lbl">관통 테마</div>
          <div class="chips">
            {Object.values(THEMES).map((t, i) => (
              <span class={`chip ${i === 0 ? "blue" : ""}`}>{t}</span>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- NOW -->
  <section id="now">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-label">Now</span>
        <span class="sec-title">지금 집중하는 문제</span>
      </div>
      <p class="sec-note reveal">진행중인 관심사를 분기별로 기록합니다. <a class="sec-note-link" href="/roadmap/">→ 시장 좌표·학습 로드맵 전체 보기</a></p>
      <div class="now-grid">
        {
          now.map((n) => (
            <div class="now-card reveal">
              <span class="now-when">{n.when}</span>
              <p set:html={n.what} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-label">Work</span>
        <span class="sec-title">결정 로그 · 대표작</span>
      </div>
      <p class="sec-note reveal">
        만든 것의 목록이 아니라, 어떤 문제를 어떤 기준으로 판단했는지의 기록입니다. <a class="sec-note-link" href="/portfolio/print/">→ 포트폴리오 PDF</a>
      </p>
      <div class="work-list">
        {work.map((entry, i) => <ProjectCard entry={entry} seq={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- SIDE -->
  {
    side.length > 0 && (
      <section id="side">
        <div class="wrap">
          <div class="sec-head reveal">
            <span class="sec-label">Side</span>
            <span class="sec-title">외주 / 의뢰 작업</span>
          </div>
          <div class="work-list">
            {side.map((entry, i) => <ProjectCard entry={entry} seq={work.length + i + 1} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- LAB -->
  <section id="lab">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-label">Lab</span>
        <span class="sec-title">실험실 · 진행중 · 도구</span>
      </div>
      <p class="sec-note reveal">완성보다 가설을 시험하는 자리입니다. 정직하게 상태를 표기합니다.</p>
      <div class="lab reveal">
        {
          lab.map((e, i) => {
            const st = LAB_STATUS[e.status] ?? { label: e.status, cls: "pause" };
            return (
              <div class="lab-row">
                <span class="lab-n">{String(i + 1).padStart(2, "0")}</span>
                <span class="lab-nm">
                  <b>{e.title}</b>
                  <span>{e.oneLiner}</span>
                </span>
                <span class={`status ${st.cls}`}>{st.label}</span>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-label">About</span>
        <span class="sec-title">연결</span>
      </div>
      <div class="about-card reveal">
        <p class="about-lead">
          자동화는 조용해져야 제품이 되고, <span class="hl">AI는 결정을 대체하는 게 아니라 근거를 좁힙니다.</span>
        </p>
        <div class="writing">
          {
            FEATURED_WRITING.map((w) => (
              <a href={w.href} target="_blank" rel="noopener">
                <span class="arr">↳</span>
                <span>{w.label}</span>
              </a>
            ))
          }
        </div>
        <div class="channels">
          {
            CHANNELS.map((c) => (
              <a class="pill" href={c.href} target="_blank" rel="noopener">
                {c.label}
              </a>
            ))
          }
        </div>
        <p class="policy">
          <b>공개 범위.</b> 회사(Spacewalk) 작업물은 역할·문제·판단 기준을 그대로 적되,
          고객 정보 · 비공개 수치 · 시크릿(키·인프라 비밀)은 제외합니다. 링크는 공개된
          repo·서비스만 연결하며, 시크릿이 포함된 저장소는 링크하지 않습니다.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll(".toc a[data-spy]"));
      if (!links.length) return;
      var map = {};
      links.forEach(function (a) { map[a.getAttribute("data-spy")] = a; });
      var sections = Object.keys(map)
        .map(function (id) { return document.getElementById(id); })
        .filter(Boolean);
      var spy = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              links.forEach(function (a) { a.classList.remove("active"); });
              if (map[e.target.id]) map[e.target.id].classList.add("active");
            }
          });
        },
        { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
      );
      sections.forEach(function (s) { spy.observe(s); });
    })();

    // WORK 하위 항목 스크롤스파이 (현재 보이는 프로젝트 카드 강조)
    (function () {
      var subs = Array.prototype.slice.call(document.querySelectorAll(".toc-sub a[data-spy-sub]"));
      if (!subs.length) return;
      var map = {};
      subs.forEach(function (a) { map[a.getAttribute("data-spy-sub")] = a; });
      var cards = Object.keys(map)
        .map(function (id) { return document.getElementById(id); })
        .filter(Boolean);
      var spy = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              subs.forEach(function (a) { a.classList.remove("active"); });
              if (map[e.target.id]) map[e.target.id].classList.add("active");
            }
          });
        },
        { rootMargin: "-40% 0px -55% 0px", threshold: 0 }
      );
      cards.forEach(function (c) { spy.observe(c); });
    })();
  </script>
</BaseLayout>
