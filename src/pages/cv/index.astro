---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROFILE, CAREER, EDUCATION, SKILLS, SOLO_PROJECTS, PROJECTS, AX_PROJECTS, CASES, AWARDS, VALUES, VISION } from "../../data/cv";
import galleries from "../../data/galleries.json";
const cvShots = galleries.cv as Record<string, string[]>;

const photo = PROFILE.photo;
const initial = PROFILE.name.charAt(0);

// Projects 섹션은 'AX 직접 빌딩'을 맨 위, '회사 대표 프로젝트'를 그 아래로 그룹핑한다.
const projectGroups = [
  { label: "AI 에이전트 운영 · 자동화 · 데이터 신뢰성", note: "회사에서 검증한 운영 원리를 개인 프로젝트로 다시 만들어 증명한 작업들 — AI에게 일을 맡길 때 필요한 검증과 통제(Nova·Ground Control), 운영에서 놓치기 쉬운 일의 감지(MIRIVA), 끊기지 않는 데이터 수집(Realty)까지 직접 설계·구현했습니다(일부 오픈소스 공개).", items: AX_PROJECTS },
  { label: "개인 제품 · 직접 출시", note: "회사 밖에서 혼자 기획·개발해 실제 사용자에게 내놓은 제품입니다.", items: SOLO_PROJECTS },
  { label: "스페이스워크 · 제품 백엔드", note: "부동산 플랫폼 백엔드 · AI 기반 설계 API 서비스", items: PROJECTS },
];

// Career highlights 중 ①/② 접두 항목을 두 축으로 그룹핑 (없으면 평면 리스트)
const AXES: Record<string, string> = {
  "①": "제품을 처음부터 끝까지 만드는 일",
  "②": "조직이 AI와 안전하게 일하게 만드는 일",
};
function groupHighlights(highlights: string[]) {
  const out: { axis: string | null; items: string[] }[] = [];
  for (const h of highlights) {
    const m = h.match(/^([①②])\s+([\s\S]*)$/);
    const axis = m ? m[1] : null;
    const text = m ? m[2] : h;
    const last = out[out.length - 1];
    if (last && last.axis === axis) last.items.push(text);
    else out.push({ axis, items: [text] });
  }
  return out;
}

const toc = [
  { id: "overview", label: "Overview" },
  { id: "career", label: "Career" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills" },
  { id: "education", label: "Education" },
  { id: "cases", label: "Cases" },
  { id: "lectures", label: "Learning" },
  { id: "vision", label: "Vision" },
];
---

<BaseLayout title="이력 — 장근식" description="장근식(@givepro91) 상세 이력 위키 — 경력·프로젝트·문제 해결 사례·기술 스택.">
  <aside class="toc" aria-label="목차">
    {toc.map((t) => <a href={`#${t.id}`} data-spy={t.id}><span class="bar"></span>{t.label}</a>)}
  </aside>

  <section class="cv">
    <div class="wrap" style="max-width:900px">
      <!-- HEAD -->
      <div class="cv-head reveal">
        <div class="cv-id">
          <div class="cv-avatar">
            <span class="avatar-fallback">{initial}</span>
            {photo && (
              <img src={photo} alt={`${PROFILE.name} 프로필 사진`} loading="eager" onerror="this.remove()" />
            )}
          </div>
          <div>
            <p class="cv-kicker">log.cv — 상세 이력 / detailed résumé</p>
            <h1 class="cv-title">{PROFILE.name} <span class="cv-en">{PROFILE.nameEn}</span></h1>
            <p class="cv-sub">{PROFILE.title} · {PROFILE.subtitle}</p>
          </div>
        </div>
        <div class="cv-docs">
          <a class="pdf-btn" href="/cv/print/">이력서 PDF ↓</a>
          <a class="pdf-btn ghost" href="/cv/resume/">이력서 PDF · 새 레이아웃 ↓</a>
          <a class="pdf-btn ghost" href="/portfolio/print/">포트폴리오 PDF ↓</a>
        </div>
      </div>

      <!-- INFO CARD -->
      <div class="cv-info reveal">
        <dl>
          <div><dt>이름</dt><dd>{PROFILE.name} ({PROFILE.nameEn})</dd></div>
          <div><dt>생년월일</dt><dd>{PROFILE.birth}</dd></div>
          <div><dt>연락처</dt><dd>{PROFILE.phone}</dd></div>
          <div><dt>이메일</dt><dd><a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a></dd></div>
          <div><dt>거주</dt><dd>{PROFILE.location}</dd></div>
        </dl>
        <div class="cv-links">
          {PROFILE.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      </div>

      <!-- LIVE CALLOUT — 이력서와 함께 보면 좋은 자료 두 개 -->
      <div class="cv-callout reveal">
        <p class="cv-callout-lead">이력서와 함께 보면 좋은 자료 <b>두 개</b>를 같이 두었습니다 ↓</p>
        <div class="cv-callout-cards">
          <a class="cv-callout-card" href="https://givepro91.github.io" target="_blank" rel="noopener">
            <span class="ccc-k">인터랙티브 포트폴리오</span>
            <span class="ccc-t">Keunsik Works</span>
            <span class="ccc-d">프로젝트를, 무엇을 만들었나보다 <b>왜 그렇게 판단했나</b>를 중심으로 기록</span>
            <span class="ccc-u">givepro91.github.io ↗</span>
          </a>
          <a class="cv-callout-card" href="https://ax-field-guide.vercel.app" target="_blank" rel="noopener">
            <span class="ccc-k">공개 필드가이드</span>
            <span class="ccc-t">Fieldwork</span>
            <span class="ccc-d"><b>해본 것과 조사한 것을 글마다 구분해</b> 밝히는 실행 가이드 — 끝까지 갈 수 있는 하나의 경로</span>
            <span class="ccc-u">ax-field-guide.vercel.app ↗</span>
          </a>
        </div>
      </div>

      <!-- OVERVIEW -->
      <section id="overview" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">01</span> Overview</h2>
        {PROFILE.summary.split("\n\n").map((p) => {
          const isAxis = p.startsWith("①") || p.startsWith("②");
          const i = p.indexOf(" — ");
          return isAxis && i > -1
            ? <p class="cv-lead cv-axis"><b>{p.slice(0, i)}</b>{p.slice(i)}</p>
            : <p class="cv-lead">{p}</p>;
        })}
        {PROFILE.current.split("\n\n").map((p, i) => (
          <p class="cv-now">{i === 0 ? <Fragment><span class="now-tag">NOW</span>{p}</Fragment> : p}</p>
        ))}
      </section>

      <!-- CAREER -->
      <section id="career" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">02</span> Career <span class="cv-h2-note">— 10년차 · 2016–2026</span></h2>
        {CAREER.map((c) => (
          <article class="cv-entry">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-entry-title">{c.company}</h3>
                <p class="cv-entry-role">{c.role}</p>
              </div>
              <div class="cv-entry-period">{c.period}{c.duration && <span class="dur">{c.duration}</span>}</div>
            </div>
            {c.summary && <p class="cv-entry-summary">{c.summary}</p>}
            {c.highlights.some((h) => /^[①②]/.test(h))
              ? groupHighlights(c.highlights).map((g) => (
                  <div class={g.axis ? "cv-hi-grp cv-axis-group" : "cv-hi-grp"}>
                    {g.axis && <p class="cv-axis-head">{g.axis} {AXES[g.axis]}</p>}
                    <ul class="cv-list">{g.items.map((t) => <li>{t}</li>)}</ul>
                  </div>
                ))
              : <ul class="cv-list">{c.highlights.map((h) => <li>{h}</li>)}</ul>}
            {c.stack && <div class="tags">{c.stack.map((s) => <span class="tag">{s}</span>)}</div>}
          </article>
        ))}
      </section>

      <!-- PROJECTS -->
      <section id="projects" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">03</span> Projects</h2>
        {projectGroups.map((g) => (
          <div class="cv-proj-group">
            <h3 class="cv-subhead">{g.label} <span class="cv-subnote">— {g.note}</span></h3>
            {g.items.map((p) => {
              const shots = cvShots[p.name] ?? [];
              const zoomCap = `${p.name} — ${p.tagline}${p.linkLabel ? ` · ${p.linkLabel}` : ""}`;
              return (
              <article class={`cv-entry${shots.length > 0 ? " has-thumb" : ""}`}>
                <div class="cv-entry-text">
                  <div class="cv-entry-head">
                    <div>
                      <h3 class="cv-entry-title">{p.name}</h3>
                      <p class="cv-entry-role">{p.tagline}</p>
                    </div>
                    <div class="cv-entry-period">{p.period}{p.metrics && <span class="dur">{p.metrics}</span>}</div>
                  </div>
                  <p class="cv-entry-summary">{p.overview}</p>
                  <ul class="cv-list">{p.achievements.map((a) => <li>{a}</li>)}</ul>
                  <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
                  <div class="cv-proj-links">
                    {p.link && <a class="cv-extlink" href={p.link} target="_blank" rel="noopener">{p.linkLabel ?? p.link} ↗</a>}
                    {p.workSlug && <a class="cv-worklink" href={`/work/${p.workSlug}/`}>결정 로그 보기 →</a>}
                  </div>
                </div>
                {shots.length > 0 && (
                  <figure
                    class="shot cv-shot"
                    data-zoom
                    data-zoom-src={shots[0]}
                    data-zoom-index="0"
                    data-gallery={JSON.stringify(shots)}
                    data-zoom-cap={zoomCap}
                    tabindex="0"
                    role="button"
                    aria-label={`${p.name} 제품 화면 크게 보기${shots.length > 1 ? ` (${shots.length}장)` : ""}`}
                  >
                    <img class="cv-thumb" src={shots[0]} alt={`${p.name} 제품 화면`} loading="lazy" />
                    {shots.length > 1 && <span class="shot-count">＋{shots.length - 1}</span>}
                    <figcaption class="shot-cap">제품 화면{p.linkLabel ? ` · ${p.linkLabel}` : ""}{shots.length > 1 ? ` · ${shots.length}컷` : ""}</figcaption>
                  </figure>
                )}
              </article>
              );
            })}
          </div>
        ))}
      </section>

      <!-- SKILLS -->
      <section id="skills" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">04</span> Skills</h2>
        <div class="cv-skills">
          {SKILLS.map((g) => (
            <div class="cv-skill-group">
              <h3 class="cv-skill-h">{g.group}</h3>
              <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <!-- EDUCATION -->
      <section id="education" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">05</span> Education</h2>
        {EDUCATION.map((e) => (
          <article class="cv-entry">
            <div class="cv-entry-head">
              <div><h3 class="cv-entry-title">{e.school}</h3><p class="cv-entry-role">{e.degree}</p></div>
              <div class="cv-entry-period">{e.period}</div>
            </div>
            <ul class="cv-list">{e.notes.map((n) => <li>{n}</li>)}</ul>
          </article>
        ))}
      </section>

      <!-- CASES -->
      <section id="cases" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">06</span> Problem-Solving Cases</h2>
        <p class="sec-note">상황 → 접근 → 성과로 정리한 문제 해결 기록입니다.</p>
        {CASES.map((c) => (
          <article class="cv-case">
            <h3 class="cv-case-title">{c.title}</h3>
            <div class="cv-case-grid">
              <div><span class="cv-case-lbl">상황</span><ul>{c.situation.map((x) => <li>{x}</li>)}</ul></div>
              <div><span class="cv-case-lbl">접근</span><ul>{c.approach.map((x) => <li>{x}</li>)}</ul></div>
              <div><span class="cv-case-lbl">성과</span><ul>{c.result.map((x) => <li>{x}</li>)}</ul></div>
            </div>
          </article>
        ))}
      </section>

      <!-- LEARNING -->
      <section id="lectures" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">07</span> Learning <span class="cv-h2-note">— 학습과 공유</span></h2>
        <p class="sec-note">온라인 강의로 익히고, 기술 블로그·Fieldwork로 정리·공유합니다 — 학습을 자산으로 바꾸는 루프.</p>
        <ul class="cv-list">{AWARDS.map((a) => <li>{a}</li>)}</ul>
      </section>

      <!-- VISION -->
      <section id="vision" class="cv-section reveal">
        <h2 class="cv-h2"><span class="n">08</span> Value & Vision</h2>
        <ul class="cv-values">{VALUES.map((v) => <li>{v}</li>)}</ul>
        <blockquote class="cv-vision-q">{VISION.headline}</blockquote>
        {VISION.principles.map((pr) => (
          <p class="cv-vision-p"><strong>{pr.title}</strong> — {pr.text}</p>
        ))}
      </section>

      <div class="cv-foot reveal">
        <a class="pdf-btn" href="/cv/print/">이력서 PDF ↓</a>
        <a class="pdf-btn ghost" href="/cv/resume/">이력서 PDF · 새 레이아웃 ↓</a>
        <a class="pdf-btn ghost" href="/portfolio/print/">포트폴리오 PDF ↓</a>
        <a class="cv-backlink" href="/">← Keunsik Works (작업·판단 기록)</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll(".toc a[data-spy]"));
      if (!links.length) return;
      var map = {};
      links.forEach(function (a) { map[a.getAttribute("data-spy")] = a; });
      var sections = Object.keys(map).map(function (id) { return document.getElementById(id); }).filter(Boolean);
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            links.forEach(function (a) { a.classList.remove("active"); });
            if (map[e.target.id]) map[e.target.id].classList.add("active");
          }
        });
      }, { rootMargin: "-30% 0px -60% 0px", threshold: 0 });
      sections.forEach(function (s) { spy.observe(s); });
    })();
  </script>
</BaseLayout>
