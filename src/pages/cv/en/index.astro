---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  EN_PROFILE,
  EN_EXPERIENCE,
  EN_PERSONAL_PRODUCTS,
  EN_SELECTED_PROJECTS,
  EN_SKILLS,
  EN_EDUCATION,
} from "../../../data/cv.en";

const external = (href: string) => href.startsWith("http");
---

<BaseLayout
  title="English CV — Keun-sik Jang"
  description="English CV for Keun-sik Jang — an engineer building AI products from a backend foundation."
  locale="en"
  cvHref="/cv/en/"
  cvLabel="English CV"
  footerGive="@givepro91 · Work shared openly"
>
  <div class="en-cv-page">
    <div class="en-cv-actions" aria-label="CV actions">
      <a href="/cv/">한국어 CV</a>
      <button id="enCvPrint" type="button">Print / Save PDF <span>⌘P</span></button>
    </div>

    <div class="en-cv-paper">
      <header class="en-cv-header">
        <div>
          <p class="en-eyebrow">ENGINEER · BACKEND → AI PRODUCTS</p>
          <h1>{EN_PROFILE.name}</h1>
          <p class="en-title">{EN_PROFILE.title}</p>
          <p class="en-subtitle">{EN_PROFILE.subtitle}</p>
          <div class="en-contact">
            <a href={`mailto:${EN_PROFILE.email}`}>{EN_PROFILE.email}</a>
            <span>{EN_PROFILE.location}</span>
            {EN_PROFILE.links.map((link) => (
              <a href={link.href} target={external(link.href) ? "_blank" : undefined} rel={external(link.href) ? "noopener" : undefined}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
        <img class="en-photo" src={EN_PROFILE.photo} alt={`${EN_PROFILE.name} profile`} width="104" height="104" />
      </header>

      <div class="en-cv-grid">
        <main>
          <section class="en-section en-profile-section">
            <div class="en-section-heading"><span>01</span><h2>Profile</h2></div>
            <p class="en-lede">{EN_PROFILE.summary}</p>
            <div class="en-now">
              <span class="en-label">NOW</span>
              <p>Exploring my next role after Spacewalk and building personal products in the meantime. I make system boundaries explicit: where AI can act, where a person must approve, and how a change can be reversed and audited.</p>
            </div>
          </section>

          <section class="en-section" id="experience">
            <div class="en-section-heading"><span>02</span><h2>Experience</h2></div>
            {EN_EXPERIENCE.map((experience, index) => (
              <article class:list={["en-experience", index === 0 && "en-experience-featured"]}>
                <div class="en-entry-head">
                  <div>
                    <h3>{experience.company}</h3>
                    <p>{experience.role}</p>
                  </div>
                  <time>{experience.period}</time>
                </div>
                {experience.summary && <p class="en-entry-summary">{experience.summary}</p>}
                {experience.bullets && (
                  <ul>
                    {experience.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
                {experience.stack && <p class="en-stack">{experience.stack.join(" · ")}</p>}
              </article>
            ))}
          </section>

          <section class="en-section" id="products">
            <div class="en-section-heading"><span>03</span><h2>Personal Products</h2></div>
            <p class="en-section-note">Products planned, built, released, and operated independently.</p>
            <div class="en-product-list">
              {EN_PERSONAL_PRODUCTS.map((product) => (
                <article class="en-project en-product">
                  <div class="en-entry-head">
                    <div>
                      <h3>{product.name}</h3>
                      <p>{product.role}</p>
                    </div>
                    <time>{product.period}</time>
                  </div>
                  <p class="en-entry-summary">{product.summary}</p>
                  <ul>{product.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                  <div class="en-project-foot">
                    <p class="en-stack">{product.stack.join(" · ")}</p>
                    {product.links && (
                      <div class="en-project-links">
                        {product.links.map((link) => (
                          <a href={link.href} target={external(link.href) ? "_blank" : undefined} rel={external(link.href) ? "noopener" : undefined}>{link.label} ↗</a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="en-section" id="projects">
            <div class="en-section-heading"><span>04</span><h2>Selected Projects</h2></div>
            <div class="en-project-list">
              {EN_SELECTED_PROJECTS.map((project) => (
                <article class="en-project en-project-compact">
                  <div class="en-entry-head">
                    <div>
                      <h3>{project.name}</h3>
                      <p>{project.role}</p>
                    </div>
                    <time>{project.period}</time>
                  </div>
                  <p class="en-entry-summary">{project.summary}</p>
                  <ul>{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                  <div class="en-project-foot">
                    <p class="en-stack">{project.stack.join(" · ")}</p>
                    {project.links && (
                      <div class="en-project-links">
                        {project.links.map((link) => (
                          <a href={link.href} target={external(link.href) ? "_blank" : undefined} rel={external(link.href) ? "noopener" : undefined}>{link.label} ↗</a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        </main>

        <aside class="en-sidebar">
          <section class="en-side-section">
            <h2>Core Strengths</h2>
            <ul class="en-strengths">
              <li><b>Backend foundations</b><span>Service architecture, asynchronous processing, APIs, and data pipelines.</span></li>
              <li><b>Product delivery</b><span>From problem framing and UX to infrastructure, model serving, release, and operations.</span></li>
              <li><b>AI operations</b><span>Human approval, reversibility, audit trails, and safe boundaries for agents.</span></li>
              <li><b>Reliable systems</b><span>Reproducible results, graceful retries, checkpoints, and recovery paths.</span></li>
            </ul>
          </section>

          <section class="en-side-section">
            <h2>Skills</h2>
            {EN_SKILLS.map((group) => (
              <div class="en-skill-group">
                <h3>{group.label}</h3>
                <p>{group.items.join(" · ")}</p>
              </div>
            ))}
          </section>

          <section class="en-side-section">
            <h2>Education</h2>
            <div class="en-education">
              <h3>{EN_EDUCATION.school}</h3>
              <p>{EN_EDUCATION.degree}</p>
              <time>{EN_EDUCATION.period}</time>
            </div>
          </section>

          <section class="en-side-section en-side-note">
            <h2>Working Principle</h2>
            <p>AI adoption is not mainly about attaching a model. It is about deciding where people judge and where systems act.</p>
            <a href="https://givepro91.github.io">Read the portfolio →</a>
          </section>
        </aside>
      </div>

      <footer class="en-cv-footer">
        <span>{EN_PROFILE.name} · English CV · 2026</span>
        <a href="https://givepro91.github.io">givepro91.github.io ↗</a>
      </footer>
    </div>
  </div>

  <script is:inline>
    var printButton = document.getElementById("enCvPrint");
    if (printButton) printButton.addEventListener("click", function () { window.print(); });
  </script>
</BaseLayout>

<style>
  .en-cv-page {
    --en-ink: #16181c;
    --en-body: #3d4249;
    --en-muted: #737a85;
    --en-rule: #d9dde3;
    --en-soft: #f5f7fa;
    --en-blue: #2563eb;
    background: #eef1f5;
    padding: 28px 0 70px;
    color: var(--en-body);
    overflow-x: hidden;
  }
  .en-cv-actions {
    width: min(210mm, calc(100% - 36px));
    margin: 0 auto 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    font-family: var(--mono);
    font-size: 12px;
  }
  .en-cv-actions a { color: var(--en-muted); }
  .en-cv-actions a:hover { color: var(--en-blue); }
  .en-cv-actions button {
    border: 0;
    border-radius: 999px;
    padding: 9px 15px;
    background: var(--en-blue);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .en-cv-actions button:hover { opacity: .9; }
  .en-cv-actions button span { opacity: .72; }
  .en-cv-paper {
    width: min(210mm, calc(100% - 36px));
    margin: 0 auto;
    padding: 15mm 14mm 12mm;
    background: #fff;
    box-shadow: 0 8px 28px rgba(16, 24, 40, .1);
  }
  .en-cv-header {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 22px;
    border-bottom: 2px solid var(--en-ink);
  }
  .en-cv-header > div, .en-cv-grid main, .en-section { min-width: 0; }
  .en-eyebrow {
    color: var(--en-blue);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
  }
  .en-cv-header h1 {
    margin-top: 13px;
    color: var(--en-ink);
    font-size: 35px;
    line-height: 1.08;
    letter-spacing: -.045em;
  }
  .en-title { margin-top: 9px; color: var(--en-ink); font-size: 16px; font-weight: 600; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .en-subtitle { margin-top: 3px; color: var(--en-muted); font-size: 12px; }
  .en-contact { display: flex; flex-wrap: wrap; gap: 5px 14px; margin-top: 16px; font-family: var(--mono); font-size: 10px; }
  .en-contact a { color: var(--en-blue); }
  .en-contact span { color: var(--en-muted); }
  .en-photo { width: 88px; height: 88px; flex: none; border-radius: 50%; object-fit: cover; object-position: center top; background: var(--en-soft); }
  .en-cv-grid { display: grid; grid-template-columns: minmax(0, 1.72fr) minmax(190px, .78fr); gap: 30px; margin-top: 24px; }
  .en-section + .en-section { margin-top: 28px; }
  .en-section-heading { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
  .en-section-heading span { color: var(--en-blue); font-family: var(--mono); font-size: 10px; font-weight: 700; }
  .en-section-heading h2 { color: var(--en-ink); font-size: 18px; letter-spacing: -.03em; }
  .en-lede { color: var(--en-ink); font-size: 12.5px; line-height: 1.66; }
  .en-now { display: grid; grid-template-columns: auto 1fr; gap: 12px; margin-top: 13px; padding: 10px 12px; background: var(--en-soft); border-left: 3px solid var(--en-blue); }
  .en-label { color: var(--en-blue); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .08em; }
  .en-now p { font-size: 11px; line-height: 1.58; }
  .en-experience, .en-project { padding: 15px 0; border-top: 1px solid var(--en-rule); }
  .en-experience-featured { padding-top: 0; border-top: 0; }
  .en-entry-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .en-entry-head h3 { color: var(--en-ink); font-size: 14px; line-height: 1.3; letter-spacing: -.02em; }
  .en-entry-head p { margin-top: 3px; color: var(--en-muted); font-size: 11px; line-height: 1.4; }
  .en-entry-head time, .en-education time { flex: none; color: var(--en-muted); font-family: var(--mono); font-size: 10px; white-space: nowrap; }
  .en-entry-summary { margin-top: 7px; color: var(--en-body); font-size: 11px; line-height: 1.58; }
  .en-experience ul, .en-project ul { display: flex; flex-direction: column; gap: 4px; margin-top: 7px; padding-left: 15px; }
  .en-experience li, .en-project li { font-size: 10.5px; line-height: 1.53; }
  .en-stack { margin-top: 8px; color: var(--en-muted); font-family: var(--mono); font-size: 9px; line-height: 1.55; }
  .en-section-note { margin: -4px 0 11px; color: var(--en-muted); font-size: 11px; }
  .en-product-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .en-project-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .en-project-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px 12px; font-family: var(--mono); font-size: 9.5px; }
  .en-project-links a { color: var(--en-blue); white-space: nowrap; }
  .en-project-compact { padding: 12px 0; }
  .en-project-compact .en-entry-summary { margin-top: 5px; }
  .en-project-compact li { font-size: 10px; }
  .en-project-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .en-project-list .en-project-foot { display: block; }
  .en-project-list .en-project-links { justify-content: flex-start; margin-top: 5px; }
  .en-sidebar { border-left: 1px solid var(--en-rule); padding-left: 22px; }
  .en-side-section { padding-bottom: 21px; margin-bottom: 21px; border-bottom: 1px solid var(--en-rule); }
  .en-side-section:last-child { border-bottom: 0; }
  .en-side-section h2 { color: var(--en-ink); font-size: 13px; letter-spacing: -.02em; }
  .en-strengths { display: flex; flex-direction: column; gap: 13px; margin-top: 12px; }
  .en-strengths li { display: grid; gap: 3px; }
  .en-strengths b { color: var(--en-ink); font-size: 10.5px; }
  .en-strengths span { font-size: 10px; line-height: 1.5; }
  .en-skill-group + .en-skill-group { margin-top: 12px; }
  .en-skill-group h3 { margin-top: 11px; color: var(--en-muted); font-family: var(--mono); font-size: 9px; font-weight: 600; }
  .en-skill-group p { margin-top: 4px; color: var(--en-body); font-size: 10px; line-height: 1.55; }
  .en-education { display: grid; gap: 4px; margin-top: 11px; }
  .en-education h3 { color: var(--en-ink); font-size: 11px; line-height: 1.4; }
  .en-education p { font-size: 10px; line-height: 1.45; }
  .en-education time { margin-top: 2px; }
  .en-side-note p { margin-top: 10px; font-size: 10px; line-height: 1.6; }
  .en-side-note a { display: inline-block; margin-top: 9px; color: var(--en-blue); font-family: var(--mono); font-size: 9.5px; }
  .en-cv-footer { display: flex; justify-content: space-between; gap: 16px; margin-top: 26px; padding-top: 10px; border-top: 1px solid var(--en-rule); color: var(--en-muted); font-family: var(--mono); font-size: 9px; }
  .en-cv-footer a { color: var(--en-blue); }

  @media screen and (max-width: 820px) {
    .en-cv-page { padding-top: 0; }
    .en-cv-actions, .en-cv-paper { width: 100%; max-width: 100vw; }
    .en-cv-actions { padding: 16px 18px 0; }
    .en-cv-paper { padding: 28px 18px 44px; box-shadow: none; }
    .en-cv-header { gap: 18px; }
    .en-cv-grid { grid-template-columns: 1fr; gap: 36px; }
    .en-product-list, .en-project-list { grid-template-columns: 1fr; }
    .en-sidebar { border-left: 0; border-top: 2px solid var(--en-ink); padding: 25px 0 0; }
  }
  @media screen and (max-width: 520px) {
    .en-cv-actions button span { display: none; }
    .en-cv-header { flex-direction: column-reverse; }
    .en-cv-header h1 { font-size: 31px; }
    .en-cv-actions button { white-space: normal; }
    .en-contact { min-width: 0; }
    .en-contact a, .en-contact span { overflow-wrap: anywhere; }
    .en-entry-head { align-items: flex-start; flex-direction: column; gap: 3px; }
    .en-entry-head time { white-space: normal; }
    .en-now { grid-template-columns: 1fr; gap: 4px; }
    .en-project-foot, .en-cv-footer { align-items: flex-start; flex-direction: column; }
    .en-project-links { justify-content: flex-start; }
  }
  @media print {
    @page { size: A4; margin: 0; }
    body { background: #fff !important; }
    .top, .foot, .en-cv-actions { display: none !important; }
    .en-cv-page { padding: 0; background: #fff; }
    .en-cv-paper { width: 210mm; margin: 0; padding: 10mm 12mm 8mm; box-shadow: none; }
    .en-cv-header { padding-bottom: 16px; }
    .en-cv-grid { gap: 18px; margin-top: 16px; }
    .en-section + .en-section { margin-top: 17px; }
    .en-section-heading { margin-bottom: 8px; }
    .en-now { margin-top: 9px; padding: 8px 10px; }
    .en-experience, .en-project { padding: 9px 0; }
    .en-entry-summary { margin-top: 5px; font-size: 10px; line-height: 1.45; }
    .en-experience ul, .en-project ul { gap: 2px; margin-top: 5px; }
    .en-experience li, .en-project li { font-size: 9.5px; line-height: 1.42; }
    .en-stack { margin-top: 5px; font-size: 8.5px; }
    .en-product-list, .en-project-list { gap: 0 14px; }
    .en-project-compact { padding: 8px 0; }
    .en-experience, .en-project { break-inside: avoid; }
    .en-sidebar { padding-left: 16px; }
    .en-side-section { padding-bottom: 15px; margin-bottom: 15px; }
    .en-strengths { gap: 9px; margin-top: 8px; }
    .en-skill-group + .en-skill-group { margin-top: 8px; }
    .en-skill-group h3 { margin-top: 8px; }
    .en-cv-footer { margin-top: 14px; }
  }
</style>
