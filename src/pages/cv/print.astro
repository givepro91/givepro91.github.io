---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROFILE, CAREER, EDUCATION, SOLO_PROJECTS, PROJECTS, AX_PROJECTS, HIGHLIGHTS, AWARDS, VISION } from "../../data/cv";
// CORE SKILLS — 카테고리형 인라인 목록(스캔성↑·ATS 친화). 뱃지 미사용 — /cv/resume 는 같은 목록을 알약 뱃지로 렌더한다.
import { SKILL_GROUPS } from "../../data/skillGroups";

// 제출 PDF는 대표 경력(featured)만 풀 디테일, 나머지는 한 줄(mini)로 — 밀도 관리.
const detailed = CAREER.filter((c) => c.featured);
const mini = CAREER.filter((c) => !c.featured);


// Career highlights 중 ①/② 접두 항목을 두 축 헤더로 그룹핑 (PDF도 ①/②가 자기설명되게 — 웹과 동일)
const AXES: Record<string, string> = {
  "①": "제품을 처음부터 끝까지 만드는 일",
  "②": "조직이 AI와 안전하게 일하게 만드는 일",
};
function groupHighlights(highlights: string[]) {
  const out: { axis: string | null; items: string[] }[] = [];
  for (const h of highlights) {
    const m = h.match(/^([①②])\s+([\s\S]*)$/);
    const axis = m ? m[1] : null;
    const text = m ? m[2] : h;
    const last = out[out.length - 1];
    if (last && last.axis === axis) last.items.push(text);
    else out.push({ axis, items: [text] });
  }
  return out;
}
---

<BaseLayout title="이력서 (PDF)" description="장근식 이력서">
  <div class="print-actions">
    <a href="/cv/" class="pa-back">← 상세 위키</a>
    <button id="printBtn" class="pa-print">PDF로 저장 / 인쇄 ⌘P</button>
  </div>

  <section class="resume">
    <header class="r-head">
      <div class="r-id">
        <h1>{PROFILE.name} <span class="r-en">{PROFILE.nameEn}</span></h1>
        <p class="r-title">{PROFILE.title} · {PROFILE.subtitle}</p>
      </div>
      <div class="r-contact">
        <a class="r-link" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        <span>{PROFILE.phone}</span>
        <a class="r-link" href="https://github.com/givepro91">github.com/givepro91</a>
        <a class="r-link" href="https://givepro91.github.io">givepro91.github.io</a>
      </div>
    </header>

    {PROFILE.summary.split("\n\n").map((p) => <p class="r-summary">{p}</p>)}

    <div class="r-callout">
      <span class="r-callout-lead">이력서와 함께 보면 좋은 자료 두 개를 같이 두었습니다 →</span>
      <span class="r-callout-item"><b>인터랙티브 포트폴리오</b> · 프로젝트를 왜 그렇게 판단했는지 중심으로 기록 — <a class="r-callout-u" href="https://givepro91.github.io">givepro91.github.io</a></span>
      <span class="r-callout-item"><b>Fieldwork</b> · 해본 것과 조사한 것을 글마다 구분해 밝히는 실행 필드가이드 — <a class="r-callout-u" href="https://ax-field-guide.vercel.app">ax-field-guide.vercel.app</a></span>
    </div>

    <section class="r-block">
      <h2>핵심 역량 · Highlights</h2>
      <ul class="r-highlights">{HIGHLIGHTS.slice(0, 8).map((h) => <li>{h}</li>)}</ul>
    </section>

    <section class="r-block r-keep">
      <h2>Core Skills</h2>
      <div class="r-skillgrid">
        {SKILL_GROUPS.map((g) => (
          <div class="r-skillrow">
            <span class="r-skillcat">{g.cat}</span>
            <span class="r-skillitems">{g.items.join(" · ")}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="r-block">
      <h2>Experience</h2>
      {detailed.map((c) => (
        <div class="r-job">
          <div class="r-job-head">
            <span class="r-co">{c.company}</span>
            <span class="r-role">{c.role}</span>
            <span class="r-period">{c.period}{c.duration ? ` · ${c.duration}` : ""}</span>
          </div>
          {c.summary && <p class="r-job-sum">{c.summary}</p>}
          {c.featured && c.highlights.some((h) => /^[①②]/.test(h))
            ? groupHighlights(c.highlights).map((g) => (
                <Fragment>
                  {g.axis && <p class="r-axis-head">{g.axis} {AXES[g.axis]}</p>}
                  <ul>{g.items.map((t) => <li>{t}</li>)}</ul>
                </Fragment>
              ))
            : <ul>{(c.featured ? c.highlights : c.highlights.slice(0, 3)).map((h) => <li>{h}</li>)}</ul>}
          {c.stack && <p class="r-pstack">{c.stack.join(" · ")}</p>}
        </div>
      ))}
      <div class="r-mini-group">
        {mini.map((c) => (
          <div class="r-job-mini">
            <span class="r-co">{c.company}</span>
            <span class="r-role">{c.role}</span>
            <span class="r-period">{c.period}{c.duration ? ` · ${c.duration}` : ""}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="r-block">
      <h2>AI 에이전트 운영 · 자동화 · 데이터 신뢰성 — 직접 설계·구현</h2>
      <p class="r-blocknote">AI에게 일을 맡길 때 필요한 검증과 통제(Nova·Ground Control), 운영에서 놓치기 쉬운 일의 감지(MIRIVA), 끊기지 않는 데이터 수집(Realty)까지 직접 설계·구현(일부 오픈소스 공개)</p>
      {AX_PROJECTS.map((p) => (
        <div class="r-proj">
          <div class="r-proj-head">
            <span class="r-pname">{p.name}</span>
            <span class="r-ptag">{p.tagline}</span>
            <span class="r-period">{p.metrics ? `${p.metrics} · ` : ""}{p.period}</span>
          </div>
          <p class="r-job-sum">{p.overview}</p>
          <ul>{p.achievements.slice(0, 3).map((a) => <li>{a}</li>)}</ul>
          <p class="r-pstack">{p.stack.join(" · ")}</p>
        </div>
      ))}
    </section>

    <section class="r-block">
      <h2>개인 제품 · 직접 출시</h2>
      <p class="r-blocknote">회사 밖에서 혼자 기획·개발해 실제 사용자에게 내놓은 제품</p>
      {SOLO_PROJECTS.map((p) => (
        <div class="r-proj">
          <div class="r-proj-head">
            <span class="r-pname">{p.name}</span>
            <span class="r-ptag">{p.tagline}</span>
            <span class="r-period">{p.metrics ? `${p.metrics} · ` : ""}{p.period}</span>
          </div>
          <p class="r-job-sum">{p.overview}</p>
          <ul>{p.achievements.slice(0, 3).map((a) => <li>{a}</li>)}</ul>
          <p class="r-pstack">{p.stack.join(" · ")}</p>
        </div>
      ))}
    </section>

    <section class="r-block">
      <h2>스페이스워크 · 제품 백엔드 (부동산 × AI)</h2>
      {PROJECTS.map((p) => (
        <div class="r-proj">
          <div class="r-proj-head">
            <span class="r-pname">{p.name}</span>
            <span class="r-ptag">{p.tagline}</span>
            <span class="r-period">{p.period}</span>
          </div>
          <p class="r-job-sum">{p.overview}</p>
          <ul>{p.achievements.slice(0, 2).map((a) => <li>{a}</li>)}</ul>
          <p class="r-pstack">{p.stack.join(" · ")}</p>
        </div>
      ))}
    </section>

    <section class="r-block">
      <h2>Education</h2>
      {EDUCATION.map((e) => (
        <div class="r-edu">
          <div class="r-job-head">
            <span class="r-co">{e.school}</span>
            <span class="r-role">{e.degree}</span>
            <span class="r-period">{e.period}</span>
          </div>
        </div>
      ))}
    </section>

    <section class="r-block">
      <h2>Learning · 학습과 공유</h2>
      <p class="r-blocknote">온라인 강의로 익히고, 기술 블로그·Fieldwork로 정리·공유합니다 — 학습을 자산으로 바꾸는 루프.</p>
      <ul class="r-lectures">{AWARDS.map((a) => <li>{a}</li>)}</ul>
    </section>

    <section class="r-block r-vision">
      <h2>일하는 방식 · Working Principle</h2>
      <blockquote class="r-vision-q">{VISION.headline}</blockquote>
      {VISION.principles.map((pr) => (
        <p class="r-vision-p"><strong class="r-vision-t">{pr.title}</strong> — {pr.text}</p>
      ))}
    </section>

  </section>

  <script is:inline>
    var b = document.getElementById("printBtn");
    if (b) b.addEventListener("click", function () { window.print(); });
  </script>
</BaseLayout>

<style>
  .print-actions {
    max-width: 820px; margin: 24px auto 0; padding: 0 32px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--mono); font-size: 13px;
  }
  .pa-back { color: var(--muted); text-decoration: none; }
  .pa-back:hover { color: var(--accent); }
  .pa-print {
    font-family: var(--mono); font-size: 13px; cursor: pointer;
    background: var(--accent); color: #fff; border: none;
    padding: 9px 18px; border-radius: 999px;
  }
  .pa-print:hover { opacity: 0.9; }

  .resume {
    max-width: 820px; margin: 28px auto 80px; padding: 52px 56px;
    background: var(--paper-2); border: 1px solid var(--hair);
    font-size: 13px; line-height: 1.6;
  }
  .r-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; border-bottom: 2px solid var(--accent); padding-bottom: 16px; }
  .r-head h1 { font-family: var(--display); font-weight: 500; font-size: 30px; letter-spacing: -0.01em; }
  .r-head .r-en { font-size: 18px; color: var(--muted); font-style: italic; margin-left: 6px; }
  .r-title { font-family: var(--mono); font-size: 12px; color: var(--accent); margin-top: 5px; }
  .r-contact { display: flex; flex-direction: column; gap: 2px; font-family: var(--mono); font-size: 11px; color: var(--muted); text-align: right; }

  .r-summary { margin: 18px 0 4px; color: var(--ink-soft); font-size: 13.5px; }
  .r-summary + .r-summary { margin-top: 7px; }

  /* 지향 · Vision — 동기/포부로 마지막 장을 채움 */
  .r-vision-q { font-size: 14.5px; font-weight: 700; color: var(--ink); line-height: 1.5; padding-left: 12px; border-left: 3px solid var(--accent); margin-bottom: 10px; }
  .r-vision-p { font-size: 12.5px; color: var(--ink-soft); line-height: 1.62; margin-top: 6px; }
  .r-vision-t { color: var(--ink); font-weight: 700; }

  /* LIVE CALLOUT — PDF 에서도 포트폴리오·Field Guide 진입점이 또렷하게 (회색 한 줄로 묻히지 않게) */
  .r-callout { margin: 14px 0 4px; padding: 11px 14px; border: 1px solid var(--accent); border-left-width: 3px; border-radius: 6px; background: var(--accent-weak); display: flex; flex-direction: column; gap: 3px; }
  .r-callout-lead { font-family: var(--mono); font-size: 10.5px; color: var(--accent); letter-spacing: 0.02em; }
  .r-callout-item { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }
  .r-callout-item b { color: var(--ink); }
  .r-callout-u { font-family: var(--mono); font-size: 11.5px; color: var(--accent); font-weight: 700; text-decoration: none; }
  .r-callout-u:hover { text-decoration: underline; }
  .r-blocknote { font-size: 11.5px; color: var(--muted); margin: -6px 0 10px; }

  /* PDF 클릭 링크 — 본문 톤 유지(색 상속·밑줄 없음), 화면에서만 hover 밑줄 */
  .r-link { color: inherit; text-decoration: none; }
  .r-link:hover { text-decoration: underline; }

  .r-block { margin-top: 22px; }
  .r-block h2 { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); border-bottom: 1px solid var(--hair); padding-bottom: 5px; margin-bottom: 12px; }
  /* CORE SKILLS — 카테고리 소제목 + 인라인 키워드(스캔성·텍스트 추출 친화, 뱃지 미사용) */
  .r-skillgrid { display: flex; flex-direction: column; gap: 7px; }
  .r-skillrow { display: grid; grid-template-columns: 134px 1fr; gap: 14px; align-items: baseline; }
  .r-skillcat { font-family: var(--mono); font-size: 10.5px; font-weight: 600; color: var(--accent); letter-spacing: 0.02em; line-height: 1.5; }
  .r-skillitems { font-size: 12px; color: var(--ink-soft); line-height: 1.6; }
  .r-lectures { columns: 2; column-gap: 32px; margin-left: 16px; }
  .r-lectures li { font-size: 12px; color: var(--ink-soft); margin-bottom: 5px; break-inside: avoid; }

  .r-highlights { margin-left: 17px; display: flex; flex-direction: column; gap: 7px; }
  .r-highlights li { font-size: 13px; line-height: 1.55; color: var(--ink-soft); }
  .r-highlights li::marker { color: var(--accent); }

  .r-job { margin-bottom: 16px; }
  .r-axis-head { font-size: 12px; font-weight: 700; color: var(--accent); margin: 9px 0 3px; letter-spacing: -0.01em; }
  .r-axis-head:first-of-type { margin-top: 6px; }
  .r-job-head, .r-proj-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .r-co, .r-pname { font-weight: 700; color: var(--ink); font-size: 14px; }
  .r-role, .r-ptag { color: var(--ink-soft); font-size: 12.5px; }
  .r-period { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .r-job-sum { font-size: 12.5px; color: var(--muted); margin: 5px 0 2px; }
  .r-job ul, .r-proj ul { margin: 5px 0 0 17px; display: flex; flex-direction: column; gap: 4px; }
  .r-job li, .r-proj li { font-size: 12.5px; line-height: 1.5; color: var(--ink-soft); }
  .r-job-mini { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding: 5px 0; border-bottom: 1px dotted var(--hair); }
  .r-proj { margin-bottom: 15px; }
  .r-pstack { font-family: var(--mono); font-size: 10.5px; color: var(--muted); margin-top: 5px; }
  .r-cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; }
  .r-edu .r-role { margin-top: 3px; }
  .r-note { margin-top: 26px; font-family: var(--mono); font-size: 11px; color: var(--muted); text-align: center; border-top: 1px solid var(--hair); padding-top: 14px; }

  @media (max-width: 640px) {
    .resume { padding: 28px 20px; }
    .r-head { flex-direction: column; align-items: flex-start; }
    .r-contact { text-align: left; }
    .r-skillrow { grid-template-columns: 1fr; gap: 1px; }
  }

  /* 인쇄: 브라우저 기본 헤더/푸터(날짜·제목·URL·페이지번호) 제거 —
     @page margin을 0으로 두면 브라우저가 헤더/푸터를 그릴 여백 자체가 사라진다.
     대신 페이지 여백은 .resume 안쪽 padding으로 준다(포트폴리오 PDF와 동일 방식). */
  @media print {
    @page { size: A4; margin: 0; }
    .resume { border: none !important; padding: 11mm 15mm !important; margin: 0 !important; background: #fff !important; }
    /* 인쇄 전용 간격 압축 — 스코프 우선순위라 global.css보다 확실히 먹음. */
    .r-block { margin-top: 6px; }
    /* 프로젝트 섹션은 통째로 다음 장에 밀지 않고(빈 페이지 방지) 항목 단위로만 유지 —
       섹션 제목·설명은 첫 항목과 붙어서 넘어가게 */
    .r-proj { break-inside: avoid; }
    .r-block h2 { break-after: avoid; }
    .r-blocknote { break-after: avoid; }
    .r-summary { margin: 8px 0 3px; }
    .r-highlights { gap: 5px; }
    .r-skillgrid { gap: 5px; }
    .r-skillitems { line-height: 1.5; }
    .r-job { margin-bottom: 7px; }
    .r-axis-head { margin: 5px 0 2px; }
    /* mini 경력은 통째로 한 페이지에 — 페이지 경계서 쪼개지지 않게 */
    .r-mini-group, .r-job-mini { break-inside: avoid; }
    .r-proj { margin-bottom: 6px; }
    .r-job-sum { margin: 3px 0 2px; }
    .r-job ul, .r-proj ul { margin-top: 3px; gap: 2px; }
    .r-job li, .r-proj li { line-height: 1.4; }
    .r-pstack { margin-top: 3px; }
    .r-blocknote { margin: -4px 0 6px; }
    .r-lectures li { margin-bottom: 1px; }
    /* 마지막 Working Principle + footer note 를 p4 안에 들이기 위한 압축 */
    .r-vision-q { font-size: 13px; margin-bottom: 5px; line-height: 1.42; }
    .r-vision-p { font-size: 11.5px; margin-top: 2px; line-height: 1.48; }
    /* footer 한 줄이 자기 혼자 다음 장으로 넘어가지 않게 — 테두리·패딩 오버헤드 제거하고 컴팩트하게 */
    .r-note { margin-top: 8px; padding-top: 0; border-top: none; }
  }
</style>
