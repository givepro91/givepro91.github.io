---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
  seq: number;
}
const { entry, seq } = Astro.props;
const d = entry.data;
const slug = entry.id.replace(/^ko\//, "");
const seqStr = "log." + String(seq).padStart(3, "0");
const linkHost = d.link ? d.link.replace(/^https?:\/\//, "").replace(/\/$/, "") : "";

const noLinkText =
  d.visibility === "secret-locked"
    ? "시크릿 이력 — 링크 비공개"
    : d.kind === "side"
      ? "사이드 외주 — 기능 설명만"
      : "비공개 — 문제·판단·배움 중심";

const badgeText =
  d.kind === "side"
    ? "사이드 외주"
    : d.visibility === "public"
      ? "공개"
      : d.visibility === "secret-locked"
        ? "시크릿·링크금지"
        : "비공개·서사";

const badgeCls =
  d.visibility === "public"
    ? "public"
    : d.visibility === "secret-locked"
      ? "locked"
      : "anon";
---

<article class={`work-card reveal${d.image ? " has-thumb" : ""}`} id={`w-${slug}`}>
  <div class="wc-main">
    <div class="wc-top">
      <span class="wc-seq">{seqStr}</span>
      {d.period && <span class="wc-period">/ {d.period}</span>}
      <span class={`badge ${badgeCls}`}>{badgeText}</span>
    </div>
    <h3 class="wc-title"><a href={`/work/${slug}/`}>{d.title}</a></h3>
    <p class="wc-pos"><span class="lead" set:html={d.positioning} /></p>
  </div>
  {d.image && <img class="wc-thumb" src={d.image} alt={`${d.title} 미리보기`} loading="lazy" />}

  <div class="decision">
    <span class="lbl">왜 이렇게 결정했나</span>
    <p set:html={d.decision} />
  </div>

  <div class="wc-foot">
    <div class="wc-meta">
      <span><b>역할</b> · {d.role}</span>
      <span><b>증명</b> · {d.shows.join(" · ")}</span>
      {d.metrics && <span><b>규모</b> · {d.metrics}</span>}
    </div>
    {d.stack && (
      <div class="wc-tags">
        {d.stack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
    {
      d.visibility === "public" && d.link ? (
        <a class="wc-link" href={`/work/${slug}/`}>
          자세히 <span class="arr">→</span>
        </a>
      ) : (
        <span class="wc-nolink"><span class="lock">●</span> {noLinkText}</span>
      )
    }
  </div>
</article>
